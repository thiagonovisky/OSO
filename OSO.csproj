<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lo que suben los usuarios no es código: si dotnet watch lo mira, reinicia la app en medio de la subida y se corta la lectura con la IA. -->
    <Watch Remove="App_Data\**" />
    <Watch Remove="wwwroot\comprobantes\**" />
    <Watch Remove="wwwroot\imagenes\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.3.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

</Project>
