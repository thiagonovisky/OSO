@model OSO.Models.Propiedades
@{
    var servicios = ViewBag.Servicios as List<OSO.Models.ServicioPropiedad> ?? new List<OSO.Models.ServicioPropiedad>();
}

<div class="services-page">
    <h2 class="page-title">Servicios</h2>

    <div class="service-actions-top oso-center-row">
        <a asp-action="AgregarTipoGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-primary">Agregar tipo de gasto</a>
    </div>

    <div class="services-grid">
        @foreach (var servicio in servicios)
        {
                var nombre = servicio.Nombre;

                <div class="service-card">
                    <div class="service-header">@nombre</div>
                    <div class="service-body">
                        <span class="service-status @servicio.EstadoCss">@servicio.Estado</span>

                        <div class="service-actions">
                            <a asp-action="ServicioDetalle" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@nombre" class="btn btn-primary">Ver detalle</a>

                            <a asp-action="AgregarGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@nombre" class="btn btn-primary">Agregar gasto</a>

                            <form asp-action="EliminarTipoGasto" asp-controller="Home" method="post" onsubmit="return confirm('¿Eliminar este tipo de gasto y sus registros asociados en esta propiedad?');">
                                <input type="hidden" name="idPropiedad" value="@Model.IdPropiedad" />
                                <input type="hidden" name="idGasto" value="@servicio.IdGasto" />
                                <button type="submit" class="btn btn-danger">Eliminar tipo</button>
                            </form>
                        </div>
                    </div>
                </div>
        }
    </div>
</div>
