@model OSO.Models.Contratos
@{
    var propiedad = ViewBag.Propiedad as OSO.Models.Propiedades;
}

<div class="revision-contrato">
    <h2>Terminar contrato</h2>
    <p class="revision-subtitulo">
        <strong>@propiedad?.Direccion</strong> · Inquilino: <strong>@ViewBag.NombreInquilino</strong> ·
        Plazo: @Model.FechaInicio.ToString("dd/MM/yyyy") al @Model.FechaFin.ToString("dd/MM/yyyy")
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-warning">
        Al terminar el contrato, el inquilino queda desvinculado de la propiedad y le avisamos. No puede rechazarlo, pero sigue viendo
        el contrato y sus gastos en modo lectura, y puede dejar por escrito su disconformidad.
    </div>

    <form asp-action="TerminarContrato" asp-controller="Home" method="post" id="formTerminar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idContrato" value="@Model.IdContrato" />

        <div class="form-group mb-3">
            <label for="motivo">Motivo</label>
            <select name="motivo" id="motivo" class="form-control" required>
                <option value="">Elegí el motivo</option>
                @foreach (var motivo in OSO.Models.ReglasContrato.MotivosFin)
                {
                    <option value="@motivo">@OSO.Models.ReglasContrato.NombreMotivoFin(motivo)</option>
                }
            </select>
            @if (!Model.YaVencio)
            {
                <small class="revision-ayuda">El contrato vence el @Model.FechaFin.ToString("dd/MM/yyyy"): "Fin de plazo" recién se puede elegir desde esa fecha.</small>
            }
        </div>

        <div id="detalleOtroMotivo" hidden>
            <div class="form-group mb-3">
                <label for="fechaFinReal">Fecha real de fin</label>
                <input type="date" name="fechaFinReal" id="fechaFinReal" class="form-control"
                       min="@Model.FechaInicio.ToString("yyyy-MM-dd")" max="@Model.FechaMaximaFinReal.ToString("yyyy-MM-dd")" />
                <small class="revision-ayuda">No puede ser futura ni anterior al inicio del contrato.</small>
            </div>
            <div class="form-group mb-3">
                <label for="descripcion">¿Qué pasó? (obligatorio)</label>
                <textarea name="descripcion" id="descripcion" class="form-control" rows="4" maxlength="500"></textarea>
                <small class="revision-ayuda">Hasta 500 caracteres. El inquilino lo va a ver.</small>
            </div>
        </div>

        <button type="submit" class="btn btn-danger" onclick="return confirm('¿Terminar el contrato? El inquilino queda desvinculado.');">Terminar contrato</button>
        <a asp-action="Propiedades" asp-controller="Home" class="btn btn-primary">Volver</a>
    </form>
</div>

<script>
    document.getElementById('motivo').addEventListener('change', function () {
        var otro = this.value !== '' && this.value !== 'FinDePlazo';
        document.getElementById('detalleOtroMotivo').hidden = !otro;
        document.getElementById('descripcion').required = otro;
        document.getElementById('fechaFinReal').required = otro;
    });
</script>
