@model OSO.Models.Contratos
@{
    var propiedad = ViewBag.Propiedad as OSO.Models.Propiedades;
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Terminar contrato</h2>
    <p class="pagina-bajada">
        <strong>@propiedad?.Direccion</strong> · Inquilino: <strong>@ViewBag.NombreInquilino</strong> ·
        Plazo: @Model.FechaInicio.ToString("dd/MM/yyyy") al @Model.FechaFin.ToString("dd/MM/yyyy")
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="alert alert-warning">
        Al terminar el contrato, el inquilino queda desvinculado de la propiedad y le avisamos. No puede rechazarlo, pero sigue viendo
        el contrato y sus gastos en modo lectura, y puede dejar por escrito su disconformidad.
    </div>

    <form asp-action="TerminarContrato" asp-controller="Home" method="post" id="formTerminar" class="panel form-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idContrato" value="@Model.IdContrato" />

        <div class="campo">
            <label for="motivo">Motivo</label>
            <select name="motivo" id="motivo" required>
                <option value="">Elegí el motivo</option>
                @foreach (var motivo in OSO.Models.ReglasContrato.MotivosFin)
                {
                    <option value="@motivo">@OSO.Models.ReglasContrato.NombreMotivoFin(motivo)</option>
                }
            </select>
            @if (!Model.YaVencio)
            {
                <small class="campo__ayuda">El contrato vence el @Model.FechaFin.ToString("dd/MM/yyyy"): "Fin de plazo" recién se puede elegir desde esa fecha.</small>
            }
        </div>

        <div id="detalleOtroMotivo" hidden>
            @if (Model.EmpiezaEnElFuturo)
            {
                <div class="alert alert-info">
                    El contrato todavía no empezó (arranca el @Model.FechaInicio.ToString("dd/MM/yyyy")): se cancela sin cobrar ningún mes.
                </div>
            }
            else
            {
                <div class="campo">
                    <label for="fechaFinReal">Fecha real de fin</label>
                    <input type="date" name="fechaFinReal" id="fechaFinReal"
                           min="@Model.FechaInicio.ToString("yyyy-MM-dd")" max="@Model.FechaMaximaFinReal.ToString("yyyy-MM-dd")" />
                    <small class="campo__ayuda">No puede ser futura ni anterior al inicio del contrato.</small>
                </div>
            }
            <div class="campo mt-3">
                <label for="descripcion">¿Qué pasó? (obligatorio)</label>
                <textarea name="descripcion" id="descripcion" rows="4" maxlength="500"></textarea>
                <small class="campo__ayuda">Hasta 500 caracteres. El inquilino lo va a ver.</small>
            </div>
        </div>

        <div class="form-acciones">
            <a asp-action="Propiedades" asp-controller="Home" class="btn btn-secondary">Volver</a>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Terminar el contrato? El inquilino queda desvinculado.');">Terminar contrato</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/terminar-contrato.js" asp-append-version="true"></script>
}
