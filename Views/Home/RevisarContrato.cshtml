@model OSO.Models.RevisionContrato
@{
    var c = Model.Contrato;
}

<div class="pagina">
    <h2 class="pagina-titulo">Revisar contrato</h2>
    <p class="pagina-bajada">
        <strong>@Model.Propiedad.Direccion</strong> · Inquilino: <strong>@Model.NombreInquilino</strong> · <span class="estado-pill estado-pill--neutro">Borrador</span>
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }

    @if (Model.LecturaFallida)
    {
        string? motivo = Model.MotivoLecturaFallida?.Trim();
        if (!string.IsNullOrEmpty(motivo) && !motivo.EndsWith('.'))
        {
            motivo += ".";
        }
        <div class="revision-advertencias" role="alert">
            <strong>La IA no pudo leer este contrato, así que los datos no se completaron.</strong>
            @if (!string.IsNullOrEmpty(motivo))
            {
                <text> @motivo</text>
            }
            else
            {
                <text> La lectura se cortó antes de terminar.</text>
            }
            <br />Completalos a mano, o cancelá el borrador más abajo y volvé a subir el archivo.
        </div>
    }

    @if (Model.Errores.Count > 0)
    {
        <div class="revision-errores" role="alert">
            <strong>Para confirmar hay que corregir:</strong>
            <ul>
                @foreach (var error in Model.Errores)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Advertencias.Count > 0)
    {
        <div class="revision-advertencias" role="status">
            <strong>Tené en cuenta:</strong>
            <ul>
                @foreach (var advertencia in Model.Advertencias)
                {
                    <li>@advertencia</li>
                }
            </ul>
        </div>
    }

    <form asp-action="GuardarRevision" asp-controller="Home" method="post" class="form-libre">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IdContrato" value="@c.IdContrato" />

        @if (Model.CamposDudosos.Count > 0)
        {
            <section class="panel">
                <h3>Para revisar primero</h3>
                <p class="panel__nota">La lectura del contrato no fue segura en estos datos.</p>
                <div class="revision-grid">
                    @foreach (var campo in Model.CamposDudosos)
                    {
                        <partial name="_CampoContrato" model="campo" />
                    }
                </div>
            </section>
        }

        <section class="panel">
            <div class="panel__cabecera">
                <h3>Datos del contrato</h3>
                @if (!string.IsNullOrEmpty(c.ArchivoContrato))
                {
                    <a asp-action="DescargarContrato" asp-controller="Home" asp-route-idContrato="@c.IdContrato" target="_blank" class="btn btn-secondary btn-sm">Ver el archivo</a>
                }
            </div>
            <p class="panel__nota">
                Régimen legal: <strong>@OSO.Models.ReglasContrato.NombreRegimen(c.RegimenLegal)</strong> (se calcula con la fecha de firma).
            </p>
            <div class="revision-grid">
                @foreach (var campo in Model.Campos)
                {
                    <partial name="_CampoContrato" model="campo" />
                }
            </div>
        </section>

        <section class="panel">
            <h3>Quién paga cada gasto</h3>
            <p class="panel__nota">Con Inquilino o Propietario el porcentaje se completa solo; con Compartido lo elegís vos.</p>
            <div class="tabla-wrap"><table class="table">
                <thead>
                    <tr>
                        <th>Gasto</th>
                        <th>Responsable</th>
                        <th>% inquilino</th>
                        <th>Cláusula del contrato</th>
                        <th>Origen</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Reglas.Count; i++)
                    {
                        var regla = Model.Reglas[i];
                        <tr class="@(regla.EsDudosa ? "campo-dudoso" : "")">
                            <td>
                                <strong>@regla.TipoGasto</strong>
                                @if (regla.TipoGasto == OSO.Models.ReglasContrato.TipoExtraordinarias)
                                {
                                    <small class="celda-sub">Antes del DNU 70/2023 las paga el propietario; el DNU permite pactar otra cosa.</small>
                                }
                                <input type="hidden" name="reglas[@i].IdGasto" value="@regla.IdGasto" />
                            </td>
                            <td data-label="Responsable">
                                <select name="reglas[@i].Responsable" class="form-control regla-responsable" aria-label="Responsable de @regla.TipoGasto">
                                    @foreach (var opcion in OSO.Models.ReglaGasto.OpcionesResponsable)
                                    {
                                        <option value="@opcion" selected="@(opcion == regla.Responsable)">@opcion</option>
                                    }
                                </select>
                            </td>
                            <td data-label="% inquilino">
                                <input type="number" name="reglas[@i].PorcentajeInquilino" class="form-control regla-porcentaje" min="0" max="100" step="0.01"
                                       value="@Formato.ParaInput(regla.PorcentajeEfectivoInquilino, "0.##")" aria-label="Porcentaje del inquilino en @regla.TipoGasto" />
                            </td>
                            <td data-label="Cláusula" class="celda-nota revision-clausula">@(string.IsNullOrEmpty(regla.TextoClausula) ? "—" : regla.TextoClausula)</td>
                            <td data-label="Origen"><span class="revision-origen revision-origen--@regla.Origen.ToLower()">@regla.Origen</span></td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>

        @if (Model.Partes.Count > 0)
        {
            <section class="panel">
                <h3>Partes y garantes que leímos</h3>
                <p class="panel__nota">Solo para consultar: por ahora no se guardan como datos del contrato.</p>
                <ul class="contrato-partes">
                    @foreach (var parte in Model.Partes)
                    {
                        <li>
                            <strong>@parte.Rol</strong>: @parte.Nombre
                            @if (!string.IsNullOrEmpty(parte.Documento)) { <text> · Doc. @parte.Documento</text> }
                            @if (!string.IsNullOrEmpty(parte.Domicilio)) { <text> · @parte.Domicilio</text> }
                            @if (!string.IsNullOrEmpty(parte.Mail)) { <text> · @parte.Mail</text> }
                        </li>
                    }
                </ul>
            </section>
        }

        <div class="form-acciones">
            <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@Model.Propiedad.IdPropiedad" class="btn btn-secondary form-acciones__aparte">Volver</a>
            <button type="submit" name="accion" value="guardar" class="btn btn-secondary" formnovalidate>Guardar borrador</button>
            <button type="submit" name="accion" value="confirmar" class="btn btn-primary">Confirmar y enviar al inquilino</button>
        </div>
    </form>

    <form asp-action="DescartarBorrador" asp-controller="Home" method="post" class="contrato-descartar"
          onsubmit="return confirm('¿Cancelar este borrador? Se pierde lo que cargaste y el archivo subido.');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idContrato" value="@c.IdContrato" />
        <span>¿Subiste el archivo equivocado? Podés descartar el borrador y empezar de nuevo.</span>
        <button type="submit" class="btn btn-danger btn-sm">Cancelar borrador sin guardar</button>
    </form>
</div>

@section Scripts {
    <script src="~/js/revisar-contrato.js" asp-append-version="true"></script>
}
