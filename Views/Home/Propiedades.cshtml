@model List<OSO.Models.Propiedades>
@{
    var linksInvitacion = ViewBag.LinksInvitacion as Dictionary<int, string> ?? new Dictionary<int, string>();
    var inquilinosPorPropiedad = ViewBag.InquilinosPorPropiedad as Dictionary<int, OSO.Models.Usuario?> ?? new Dictionary<int, OSO.Models.Usuario?>();
    bool esInquilino = ViewBag.EsInquilino == true;
    var es = new System.Globalization.CultureInfo("es-AR");
}

<h2>@(esInquilino ? "Mi alquiler" : "Mis propiedades")</h2>

@if (!esInquilino)
{
    <form class="propiedades-add-form" action='@Url.Action("AgregarPropiedad", "Home")' method="get">
        <button type="submit">Agregar Propiedad</button>
    </form>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model != null && Model.Any())
{
    foreach (var propiedad in Model)
    {
        <div class="resumen-propiedad-box">
            <div class="summary-card">
                <div class="summary-header">
                    <h3>Propiedad</h3>
                </div>

                <div class="summary-detail">
                    <img src="@Url.Content("~/imagenes/" + propiedad.Foto)" class="summary-image" alt="@propiedad.Direccion" />

                    <div class="summary-info">
                        <div class="summary-info-row">
                            <span class="label">Nombre:</span>
                            <span class="value">@propiedad.Direccion</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Dirección:</span>
                            <span class="value">@propiedad.Direccion</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Superficie:</span>
                            <span class="value">@propiedad.Superficie m²</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Ambientes:</span>
                            <span class="value">@propiedad.Ambientes</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Estado:</span>
                            <span class="summary-estado @(propiedad.Estado == "Ocupada" ? "al-dia" : "pendiente")">
                                @(propiedad.Estado == "Ocupada" ? "✓ Ocupada" : "○ No ocupada")
                            </span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Alquiler:</span>
                            <span class="value">@(propiedad.AlquilerActual.HasValue ? string.Format(es, "{0:C}", propiedad.AlquilerActual.Value) : "-")</span>
                        </div>
                        @if (esInquilino)
                        {
                            @* El inquilino sólo ve información: sin acciones sobre la propiedad. *@
                            <div class="summary-info-row">
                                <span class="label">Contrato hasta:</span>
                                <span class="value">@(propiedad.FinContrato?.ToString("dd/MM/yyyy") ?? "-")</span>
                            </div>
                            <div class="summary-info-row">
                                <span class="label">Propietario:</span>
                                <span class="value">@(string.IsNullOrWhiteSpace(propiedad.NombrePropietario) ? "-" : propiedad.NombrePropietario)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(propiedad.CorreoPropietario))
                            {
                                <div class="summary-info-row">
                                    <span class="label">Correo:</span>
                                    <span class="value">@propiedad.CorreoPropietario</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(propiedad.TelefonoPropietario))
                            {
                                <div class="summary-info-row">
                                    <span class="label">Teléfono:</span>
                                    <span class="value">@propiedad.TelefonoPropietario</span>
                                </div>
                            }
                        }
                        else if (propiedad.IdInquilino.HasValue)
                        {
                            var inquilino = inquilinosPorPropiedad.GetValueOrDefault(propiedad.IdPropiedad);
                            <div class="summary-info-row">
                                <span class="label">Inquilino:</span>
                                <span class="value">@(inquilino != null ? $"{inquilino.Nombre} {inquilino.Apellido} ({inquilino.Correo})" : "Inquilino asignado")</span>
                                <form asp-action="QuitarInquilino" asp-controller="Home" method="post" class="property-action-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                                    <button type="submit" class="btn-secondary" onclick="return confirm('¿Desvincular al inquilino de esta propiedad?');">Quitar inquilino</button>
                                </form>
                            </div>
                        }
                        else if (linksInvitacion.TryGetValue(propiedad.IdPropiedad, out var inviteUrl))
                        {
                            <div class="summary-info-row">
                                <span class="label">Link de invitación:</span>
                                <input type="text" class="value" id="invite-@propiedad.IdPropiedad" value="@inviteUrl" readonly onclick="this.select()" />
                                <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('invite-@propiedad.IdPropiedad').value).then(() => { this.textContent = '¡Copiado!'; })">Copiar</button>
                            </div>
                        }

                        @if (!esInquilino)
                        {
                        <div class="property-actions">
                            <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn property-action-btn">Servicios</a>
                            <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn property-action-btn">Contrato</a>
                            <a asp-action="EditarPropiedad" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn-secondary property-action-btn">Editar</a>

                            <form asp-action="EliminarPropiedad" asp-controller="Home" method="post" class="property-action-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                                <button type="submit" class="btn btn-danger property-action-btn" onclick="return confirm('¿Seguro que querés eliminar esta propiedad y todos sus registros asociados?');">Eliminar</button>
                            </form>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p class="propiedades-empty">@(esInquilino ? "Todavía no estás vinculado a ninguna propiedad. Pedile a tu propietario el link de invitación." : "No hay propiedades para mostrar.")</p>
}