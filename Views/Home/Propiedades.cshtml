@model List<OSO.Models.Propiedades>

<h2>Mis propiedades</h2>

<form action='@Url.Action("AgregarPropiedad", "Home")' method="get">
    <button type="submit">Agregar Propiedad</button>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model != null && Model.Any())
{
    foreach (var propiedad in Model)
    {
        <div class="resumen-propiedad-box">
            <div class="summary-card">
                <div class="summary-header">
                    <h3>Propiedad</h3>
                    <div class="summary-actions">
                        <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn">Servicios</a>
                    </div>
                </div>

                <div class="summary-detail">
                    <img src="@Url.Content("~/imagenes/" + propiedad.Foto)" class="summary-image" alt="@propiedad.Direccion" />

                    <div class="summary-info">
                        <div class="summary-info-row">
                            <span class="label">Nombre:</span>
                            <span class="value">@propiedad.Direccion</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Dirección:</span>
                            <span class="value">@propiedad.Direccion</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Superficie:</span>
                            <span class="value">@propiedad.Superficie m²</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Ambientes:</span>
                            <span class="value">@propiedad.Ambientes</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Estado:</span>
                            <span class="summary-estado @(propiedad.Estado == "Ocupada" ? "al-dia" : "pendiente")">
                                @(propiedad.Estado == "Ocupada" ? "✓ Ocupada" : "○ No ocupada")
                            </span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Alquiler:</span>
                            <span class="value">@string.Format(new System.Globalization.CultureInfo("es-AR"), "{0:C}", propiedad.Alquiler)</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Link de invitación:</span>
                            @if (propiedad.IdInquilino.HasValue)
                            {
                                <span class="value">No disponible. Ya hay inquilino asociado.</span>
                            }
                            else
                            {
                                var inviteUrl = Url.Action("Invitacion", "Home", new { idPropiedad = propiedad.IdPropiedad }, Context.Request.Scheme, Context.Request.Host.ToString());
                                <a href="@inviteUrl" target="_blank">@inviteUrl</a>
                            }
                        </div>

                        <a asp-action="EditarPropiedad" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn-secondary">Editar</a>

                        @if (propiedad.IdInquilino.HasValue)
                        {
                            <form asp-action="QuitarInquilino" asp-controller="Home" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                                <button type="submit" class="btn btn-warning" onclick="return confirm('¿Seguro que querés quitar al inquilino de esta propiedad?');">Quitar inquilino</button>
                            </form>
                        }

                        <form asp-action="EliminarPropiedad" asp-controller="Home" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Seguro que querés eliminar esta propiedad y todos sus registros asociados?');">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No hay propiedades para mostrar.</p>
}