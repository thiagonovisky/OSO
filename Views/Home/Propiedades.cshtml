@model List<OSO.Models.Propiedades>
@{
    var linksInvitacion = ViewBag.LinksInvitacion as Dictionary<int, string> ?? new Dictionary<int, string>();
    var inquilinosPorPropiedad = ViewBag.InquilinosPorPropiedad as Dictionary<int, OSO.Models.Usuario?> ?? new Dictionary<int, OSO.Models.Usuario?>();
    bool esInquilino = ViewBag.EsInquilino == true;
    var contratosConfirmados = ViewBag.ContratosConfirmados as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h2 class="propiedades-title">@(esInquilino ? "Mi alquiler" : "Mis propiedades")</h2>

@if (!esInquilino)
{
    <form class="propiedades-add-form" action='@Url.Action("AgregarPropiedad", "Home")' method="get">
        <button type="submit">Agregar Propiedad</button>
    </form>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (esInquilino && ViewBag.ContratosPendientes is List<OSO.Models.Contratos> pendientes && pendientes.Count > 0)
{
    foreach (var pendiente in pendientes)
    {
        <div class="alert alert-warning contrato-pendiente">
            Tenés un contrato para aceptar de <strong>@pendiente.Direccion</strong>.
            <a asp-action="VerContrato" asp-controller="Home" asp-route-idContrato="@pendiente.IdContrato" class="btn btn-primary">Ver contrato</a>
        </div>
    }
}

@if (esInquilino && ViewBag.ContratosFinalizados is List<OSO.Models.Contratos> finalizados && finalizados.Count > 0)
{
    <section class="panel">
        <div class="panel__cabecera">
            <h3>Contratos anteriores</h3>
            <a asp-action="MisGastos" asp-controller="Home" class="btn btn-secondary btn-sm">Ver mis gastos</a>
        </div>
        <p class="panel__nota">Podés ver el contrato y tus gastos, pero ya no están vigentes.</p>
        <div class="tabla-wrap"><table class="table">
            <thead>
                <tr><th>Propiedad</th><th>Terminó</th><th>Motivo</th><th><span class="visually-hidden">Acciones</span></th></tr>
            </thead>
            <tbody>
                @foreach (var terminado in finalizados)
                {
                    <tr>
                        <td><strong>@terminado.Direccion</strong></td>
                        <td data-label="Terminó">@terminado.FechaFinEfectiva.ToString("dd/MM/yyyy")</td>
                        <td data-label="Motivo">@OSO.Models.ReglasContrato.NombreMotivoFin(terminado.MotivoFin)</td>
                        <td class="col-accion">
                            <a asp-action="VerContrato" asp-controller="Home" asp-route-idContrato="@terminado.IdContrato" class="btn btn-secondary btn-sm">Ver contrato</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    </section>
}

@if (Model != null && Model.Count > 0)
{
    foreach (var propiedad in Model)
    {
        <div class="resumen-propiedad-box">
            <div class="summary-card">
                <div class="summary-detail">
                    <div class="summary-media">
                        <div class="summary-header">
                            <h3>@propiedad.Direccion</h3>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(propiedad.Foto))
                        {
                            <img src="@Url.Content("~/imagenes/" + propiedad.Foto)" class="summary-image" alt="@propiedad.Direccion" onerror="this.remove()" />
                        }
                    </div>

                    <div class="summary-info">
                        <div class="summary-info-row">
                            <span class="label">Superficie:</span>
                            <span class="value">@propiedad.Superficie m²</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Ambientes:</span>
                            <span class="value">@propiedad.Ambientes</span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Estado:</span>
                            <span class="summary-estado @(propiedad.EstaOcupada ? "al-dia" : "pendiente")">
                                @(propiedad.EstaOcupada ? "✓ Ocupada" : "○ Disponible")
                            </span>
                        </div>
                        <div class="summary-info-row">
                            <span class="label">Alquiler:</span>
                            <span class="value">@Formato.Pesos(propiedad.AlquilerActual)</span>
                        </div>
                        @if (esInquilino)
                        {
                            @* El inquilino sólo ve información: sin acciones sobre la propiedad. *@
                            <div class="summary-info-row">
                                <span class="label">Contrato hasta:</span>
                                <span class="value">@Formato.Fecha(propiedad.FinContrato)</span>
                            </div>
                            <div class="summary-info-row">
                                <span class="label">Propietario:</span>
                                <span class="value">@Formato.Dato(propiedad.NombrePropietario)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(propiedad.CorreoPropietario))
                            {
                                <div class="summary-info-row">
                                    <span class="label">Correo:</span>
                                    <span class="value">@propiedad.CorreoPropietario</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(propiedad.TelefonoPropietario))
                            {
                                <div class="summary-info-row">
                                    <span class="label">Teléfono:</span>
                                    <span class="value">@OSO.Models.TelefonoFormato.Formatear(propiedad.TelefonoPropietario)</span>
                                </div>
                            }
                        }
                        else if (propiedad.IdInquilino.HasValue)
                        {
                            var inquilino = inquilinosPorPropiedad.GetValueOrDefault(propiedad.IdPropiedad);
                            <div class="summary-info-row">
                                <span class="label">Inquilino:</span>
                                <span class="value">@(inquilino?.NombreConCorreo ?? "Inquilino asignado")</span>
                                @if (contratosConfirmados.TryGetValue(propiedad.IdPropiedad, out var idContratoVigente))
                                {
                                    @* Con un contrato confirmado no se desvincula a secas: se termina el contrato, con su motivo. *@
                                    <a asp-action="TerminarContrato" asp-controller="Home" asp-route-idContrato="@idContratoVigente" class="btn btn-secondary">Terminar contrato</a>
                                }
                                else
                                {
                                    <form asp-action="QuitarInquilino" asp-controller="Home" method="post" class="property-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                                        <button type="submit" class="btn btn-secondary" onclick="return confirm('¿Desvincular al inquilino de esta propiedad? Le vamos a avisar.');">Quitar inquilino</button>
                                    </form>
                                }
                            </div>
                        }
                        else if (linksInvitacion.TryGetValue(propiedad.IdPropiedad, out var inviteUrl))
                        {
                            <div class="summary-info-row">
                                <span class="label">Link de invitación:</span>
                                <input type="text" class="value" id="invite-@propiedad.IdPropiedad" value="@inviteUrl" readonly onclick="this.select()" />
                                <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('invite-@propiedad.IdPropiedad').value).then(() => { this.textContent = '¡Copiado!'; })">Copiar</button>
                            </div>
                        }

                        @if (!esInquilino)
                        {
                        <div class="property-actions">
                            <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn property-action-btn">Historial</a>
                            <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn property-action-btn">Contrato</a>
                            <a asp-action="EditarPropiedad" asp-controller="Home" asp-route-idPropiedad="@propiedad.IdPropiedad" class="btn property-action-btn">Editar</a>

                            <form asp-action="EliminarPropiedad" asp-controller="Home" method="post" class="property-action-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPropiedad" value="@propiedad.IdPropiedad" />
                                <button type="submit" class="btn btn-danger property-action-btn" onclick="return confirm('¿Seguro que querés eliminar esta propiedad y todos sus registros asociados?');">Eliminar</button>
                            </form>
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <p class="propiedades-empty">@(esInquilino ? "Todavía no estás vinculado a ninguna propiedad. Pedile a tu propietario el link de invitación." : "No hay propiedades para mostrar.")</p>
}