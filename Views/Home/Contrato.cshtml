@model OSO.Models.Propiedades
@{
    var contrato = ViewBag.Contrato as OSO.Models.Contratos;
    var enCurso = ViewBag.ContratoEnCurso as OSO.Models.Contratos;
    var ajustes = ViewBag.Ajustes as List<OSO.Models.AjusteContrato> ?? new List<OSO.Models.AjusteContrato>();
    var proximoAjuste = ViewBag.ProximoAjuste as DateTime?;
    var calculo = ViewBag.CalculoAjuste as OSO.Models.ResultadoAjuste;
}

<h2>Contrato</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (contrato != null)
{
    @if (contrato.EmpiezaEnElFuturo)
    {
        <div class="alert alert-info">Este contrato está confirmado y empieza el @contrato.FechaInicio.ToString("dd/MM/yyyy").</div>
    }
    <div class="card p-3 mb-3">
        <p><strong>Propiedad:</strong> @Model.Direccion</p>
        <p><strong>Inquilino:</strong> @ViewBag.NombreInquilino</p>
        <p><strong>Fecha inicio:</strong> @contrato.FechaInicio.ToString("dd/MM/yyyy")</p>
        <p><strong>Fecha fin:</strong> @contrato.FechaFin.ToString("dd/MM/yyyy")</p>
        <p><strong>Alquiler actual:</strong> @Formato.Pesos(contrato.MontoAlquiler)</p>
        @if (!string.IsNullOrEmpty(contrato.RegimenLegal))
        {
            <p><strong>Régimen legal:</strong> @OSO.Models.ReglasContrato.NombreRegimen(contrato.RegimenLegal)</p>
        }
        @if (!string.IsNullOrEmpty(contrato.ArchivoContrato))
        {
            <p><a asp-action="DescargarContrato" asp-controller="Home" asp-route-idContrato="@contrato.IdContrato" target="_blank">Ver el archivo del contrato</a></p>
        }
    </div>

    <div class="card p-3 mb-3 ajuste-card">
        <h3>Ajuste del alquiler</h3>
        @if (string.IsNullOrEmpty(contrato.IndiceAjuste) || proximoAjuste == null)
        {
            <p>Este contrato no tiene más ajustes programados.</p>
        }
        else
        {
            <p>
                <strong>Próximo ajuste:</strong> @proximoAjuste.Value.ToString("dd/MM/yyyy")
                (@contrato.IndiceConPorcentaje, cada @contrato.FrecuenciaAjusteMeses meses)
            </p>
            @if (calculo?.MontoNuevo != null)
            {
                <p><strong>Monto calculado:</strong> @Formato.Pesos(calculo.MontoNuevo)
                    @if (calculo.TieneDetalleIndices)
                    {
                        <small>(@contrato.IndiceAjuste @Formato.Numero(calculo.ValorHasta, "0.####") / @Formato.Numero(calculo.ValorDesde, "0.####"))</small>
                    }
                </p>
            }
            else
            {
                <p class="ajuste-faltante">@(calculo?.Faltante ?? "No se pudo calcular el ajuste.")</p>
            }

            @if (contrato.IndiceAjuste == "CasaPropia")
            {
                <p class="revision-ayuda">Cálculo a confirmar: la fuente oficial no detalla cómo se aplica el coeficiente de Casa Propia a los alquileres.</p>
            }

            @if (ViewBag.PuedeAplicarAjuste == true)
            {
                <form asp-action="AplicarAjuste" asp-controller="Home" method="post" class="ajuste-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idContrato" value="@contrato.IdContrato" />
                    @if (contrato.PermiteMontoManual)
                    {
                        <label for="montoManual">Monto a aplicar (podés cambiarlo)</label>
                        <input type="number" step="0.01" min="0.01" name="montoManual" id="montoManual" class="form-control"
                               value="@Formato.ParaInput(calculo?.MontoNuevo)"
                               data-calculado="@Formato.ParaInput(calculo?.MontoNuevo)" />
                        <small id="avisoAjuste" class="ajuste-aviso" hidden>Ese monto se aleja más de un 5% del calculado por el índice. Se puede aplicar igual: el DNU 70/2023 no pone tope.</small>
                    }
                    else
                    {
                        <p class="revision-ayuda">Por la ley, el monto es el calculado: no se puede cambiar.</p>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@(!contrato.PermiteMontoManual && calculo?.MontoNuevo == null)">Aplicar ajuste</button>
                </form>
            }
            else
            {
                <p class="revision-ayuda">Podés aplicarlo a partir de esa fecha.</p>
            }
        }

        @if (ajustes.Count > 0)
        {
            <h4>Historial de ajustes</h4>
            <table class="revision-tabla">
                <thead><tr><th>Fecha</th><th>Índice</th><th>Antes</th><th>Después</th><th>Origen</th></tr></thead>
                <tbody>
                    @foreach (var ajuste in ajustes)
                    {
                        <tr>
                            <td>@ajuste.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@ajuste.Indice</td>
                            <td>@Formato.Pesos(ajuste.MontoAnterior)</td>
                            <td>@Formato.Pesos(ajuste.MontoNuevo)
                                @if (ajuste.MuestraMontoCalculado)
                                {
                                    <small>(calculado: @Formato.Pesos(ajuste.MontoCalculado))</small>
                                }
                            </td>
                            <td>@ajuste.Origen</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <script>
        (function () {
            var input = document.getElementById('montoManual');
            if (!input) { return; }
            var calculado = parseFloat(input.dataset.calculado);
            var aviso = document.getElementById('avisoAjuste');
            input.addEventListener('input', function () {
                var propuesto = parseFloat(input.value);
                aviso.hidden = !(calculado > 0 && propuesto > 0 && Math.abs(propuesto - calculado) / calculado > 0.05);
            });
        })();
    </script>
}
else if (enCurso != null)
{
    <div class="alert alert-warning">
        @(enCurso.EsBorrador
            ? "Hay un contrato en borrador: falta que lo revises y lo confirmes."
            : "El contrato está esperando que el inquilino lo acepte.")
    </div>
}
else
{
    <div class="alert alert-warning">No hay un contrato activo para esta propiedad.</div>
}

@if (ViewBag.UltimoFinalizado is OSO.Models.Contratos terminado && contrato == null)
{
    <div class="card p-3 mb-3">
        <h3>Último contrato terminado</h3>
        <p><strong>Plazo:</strong> @terminado.FechaInicio.ToString("dd/MM/yyyy") al @terminado.FechaFinEfectiva.ToString("dd/MM/yyyy")
            · <strong>Motivo:</strong> @OSO.Models.ReglasContrato.NombreMotivoFin(terminado.MotivoFin)</p>
        @if (!string.IsNullOrWhiteSpace(terminado.DescripcionFin))
        {
            <p><strong>Descripción:</strong> @terminado.DescripcionFin</p>
        }
        @if (!string.IsNullOrWhiteSpace(terminado.DisconformidadInquilino))
        {
            <div class="alert alert-warning">
                <strong>El inquilino dejó constancia de su disconformidad</strong> (@terminado.FechaDisconformidad?.ToString("dd/MM/yyyy HH:mm")):
                <br />@terminado.DisconformidadInquilino
            </div>
        }
        @if (!string.IsNullOrEmpty(terminado.ArchivoContrato))
        {
            <p><a asp-action="DescargarContrato" asp-controller="Home" asp-route-idContrato="@terminado.IdContrato" target="_blank">Ver el archivo del contrato</a></p>
        }
    </div>
}

<div class="contrato-actions">
    @if (contrato == null && enCurso == null)
    {
        <a asp-action="SubirContrato" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-primary">Subir contrato (IA)</a>
        <a asp-action="CrearContrato" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-primary">Cargar a mano</a>
    }
    else if (enCurso != null)
    {
        <a asp-action="RevisarContrato" asp-controller="Home" asp-route-idContrato="@enCurso.IdContrato" class="btn btn-primary">@(enCurso.EsBorrador ? "Seguir revisando" : "Ver contrato")</a>
    }
    <a asp-action="Propiedades" asp-controller="Home" class="btn btn-primary">Volver</a>
</div>
