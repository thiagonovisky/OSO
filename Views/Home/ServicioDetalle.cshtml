@model OSO.Models.Propiedades
@{
    var tipo = ViewBag.Tipo as string;
    var gastos = ViewBag.Gastos as List<OSO.Models.GastoPropiedad>;
    var pendientesInquilino = ViewBag.PendientesInquilino as List<OSO.Models.PendienteContrato>;
}

<div class="service-detail-page">
    <h2 class="page-title">@tipo</h2>

    @if (pendientesInquilino != null && pendientesInquilino.Count > 0)
    {
        <div class="service-detail-panel">
            <div class="service-header-row">
                <h3>Meses sin cargar</h3>
            </div>
            <p>Estos meses del contrato todavía no tienen la factura cargada. Quien paga (vos o el inquilino) la carga desde Mis gastos al pagar su parte.</p>
            <div class="months-grid">
                @foreach (var pendiente in pendientesInquilino)
                {
                    <div class="month-item">
                        <div class="month-name">@pendiente.Periodo.ToString("MMMM yyyy")</div>
                        <div class="month-meta">
                            <span class="service-status warn">Pendiente</span>
                            <span>@pendiente.QuienPaga</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="service-detail-panel">
        <div class="service-header-row">
            <h3>Gastos registrados</h3>
            <a asp-action="AgregarGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@tipo" class="btn btn-primary">Agregar gasto</a>
        </div>

        @if (gastos != null && gastos.Count > 0)
        {
            <div class="months-grid">
                @foreach (var gasto in gastos)
                {
                    var estadoActual = gasto.Estado;
                    var nuevoEstado = estadoActual == "Pagado" ? "A pagar" : "Pagado";

                    <div class="month-item">
                        <div class="month-name">@gasto.Periodo.ToString("MMMM yyyy")</div>
                        @if (gasto.EsIncluido)
                        {
                            <div class="month-meta">
                                <span class="service-status muted">@gasto.Aclaracion</span>
                            </div>
                        }
                        else
                        {
                        <div class="month-meta">
                            <span>Monto: $@gasto.Monto</span>
                            <span>Vto: @gasto.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                        </div>

                        @if (gasto.CargadoPorInquilino)
                        {
                            <div class="month-meta">
                                <span class="service-status warn">Monto declarado por el inquilino, sin verificar</span>
                                <a asp-action="AgregarGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@tipo" asp-route-periodo="@gasto.Periodo.ToString("yyyy-MM-dd")" class="btn btn-primary">Revisar o corregir monto</a>
                            </div>
                        }

                        <form asp-action="GuardarEstadoGasto" asp-controller="Home" method="post" class="month-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idPropiedad" value="@Model.IdPropiedad" />
                            <input type="hidden" name="idGastoPropiedad" value="@gasto.IdGastoPropiedad" />
                            <input type="hidden" name="tipo" value="@tipo" />
                            <input type="hidden" name="estado" value="@nuevoEstado" />

                            <button type="submit" class="month-status @(estadoActual == "Pagado" ? "pending" : "paid")">
                                @(estadoActual == "Pagado" ? "Marcar como A pagar" : "Marcar como Pagado")
                            </button>
                        </form>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay gastos cargados para este servicio todavía.</p>
        }
    </div>
</div>
