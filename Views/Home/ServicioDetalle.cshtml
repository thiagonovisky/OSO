@model OSO.Models.Propiedades
@{
    var tipo = ViewBag.Tipo as string;
    var gastos = ViewBag.Gastos as List<OSO.Models.GastoPropiedad>;
    var pendientesInquilino = ViewBag.PendientesInquilino as List<OSO.Models.PendienteContrato>;
}

<div class="pagina">
    <h2 class="pagina-titulo">@tipo</h2>
    <p class="pagina-bajada">Mes por mes en <strong>@Model.Direccion</strong>.</p>

    @if (pendientesInquilino != null && pendientesInquilino.Count > 0)
    {
        <section class="panel">
            <h3>Meses sin cargar</h3>
            <p class="panel__nota">Estos meses del contrato todavía no tienen la factura cargada. Quien paga (vos o el inquilino) la carga desde Mis gastos al pagar su parte.</p>
            <div class="tabla-wrap"><table class="table">
                <thead>
                    <tr>
                        <th>Mes</th>
                        <th>Estado</th>
                        <th>Lo paga</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pendiente in pendientesInquilino)
                    {
                        <tr>
                            <td><strong>@OSO.Models.Formato.Mes(pendiente.Periodo)</strong></td>
                            <td data-label="Estado"><span class="estado-pill estado-pill--pagar">Sin factura</span></td>
                            <td data-label="Lo paga">@pendiente.QuienPaga</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>
    }

    <section class="panel">
        <div class="panel__cabecera">
            <h3>Gastos registrados</h3>
            <a asp-action="AgregarGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@tipo" class="btn btn-primary btn-sm">Agregar gasto</a>
        </div>

        @if (gastos != null && gastos.Count > 0)
        {
            <div class="tabla-wrap"><table class="table">
                <thead>
                    <tr>
                        <th>Mes</th>
                        <th>Estado</th>
                        <th>Vencimiento</th>
                        <th class="col-monto">Monto</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gasto in gastos)
                    {
                        var estadoActual = gasto.Estado;
                        var nuevoEstado = estadoActual == "Pagado" ? "A pagar" : "Pagado";

                        <tr>
                            <td><strong>@OSO.Models.Formato.Mes(gasto.Periodo)</strong></td>
                            @if (gasto.EsIncluido)
                            {
                                <td data-label="Estado" colspan="3"><small class="celda-sub">@gasto.Aclaracion</small></td>
                                <td class="col-accion"></td>
                            }
                            else
                            {
                                <td data-label="Estado">
                                    <span class="estado-pill estado-pill--@gasto.EstadoCss">@estadoActual</span>
                                    @if (gasto.CargadoPorInquilino)
                                    {
                                        <small class="celda-sub">Monto declarado por el inquilino, sin verificar</small>
                                    }
                                </td>
                                <td data-label="Vencimiento">@gasto.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td data-label="Monto" class="col-monto">@OSO.Models.Formato.Pesos(gasto.Monto)</td>
                                <td class="col-accion">
                                    @if (gasto.CargadoPorInquilino)
                                    {
                                        <a asp-action="AgregarGasto" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" asp-route-tipo="@tipo" asp-route-periodo="@gasto.Periodo.ToString("yyyy-MM-dd")" class="btn btn-primary btn-sm">Revisar monto</a>
                                    }
                                    <form asp-action="GuardarEstadoGasto" asp-controller="Home" method="post" class="form-en-linea">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPropiedad" value="@Model.IdPropiedad" />
                                        <input type="hidden" name="idGastoPropiedad" value="@gasto.IdGastoPropiedad" />
                                        <input type="hidden" name="tipo" value="@tipo" />
                                        <input type="hidden" name="estado" value="@nuevoEstado" />
                                        <button type="submit" class="btn btn-secondary btn-sm">
                                            @(estadoActual == "Pagado" ? "Marcar a pagar" : "Marcar pagado")
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table></div>
        }
        else
        {
            <p class="seccion-gastos__vacio">No hay gastos cargados para este servicio todavía.</p>
        }
    </section>

    <div class="form-acciones form-acciones--centro">
        <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-secondary">Volver al historial</a>
    </div>
</div>
