@model OSO.Models.CalendarioMes
@{
    ViewData["Title"] = "Calendario";
    string nombreMes = OSO.Models.CalendarioMes.NombreDelMes(Model.Mes);
    string nombreMesAnterior = OSO.Models.CalendarioMes.NombreDelMes(Model.MesAnterior);
    string nombreMesSiguiente = OSO.Models.CalendarioMes.NombreDelMes(Model.MesSiguiente);
}

<div class="cal-page">
    <h1 class="cal-title">CALENDARIO</h1>

    <div class="cal-layout">
            @* El selector de mes va en su propia fila, así "Próximos eventos" arranca a la altura de los días de la semana. *@
            <nav class="cal-nav" aria-label="Cambiar de mes">
                <a class="cal-nav__btn" asp-action="Calendario" asp-route-anio="@Model.MesAnterior.Year" asp-route-mes="@Model.MesAnterior.Month"
                   aria-label="Mes anterior (@nombreMesAnterior @Model.MesAnterior.Year)">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <p class="cal-nav__current">@nombreMes @Model.Mes.Year</p>
                <a class="cal-nav__btn" asp-action="Calendario" asp-route-anio="@Model.MesSiguiente.Year" asp-route-mes="@Model.MesSiguiente.Month"
                   aria-label="Mes siguiente (@nombreMesSiguiente @Model.MesSiguiente.Year)">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
            </nav>

        <section class="cal-grid-wrap" aria-label="Calendario de @nombreMes @Model.Mes.Year">
            <div class="cal-grid cal-grid--head">
                @foreach (var nombreDia in OSO.Models.CalendarioMes.NombresDias)
                {
                    <span>@nombreDia</span>
                }
            </div>
            <div class="cal-grid">
                @for (int i = 0; i < Model.CeldasVacias; i++)
                {
                    <div class="cal-cell cal-cell--empty"></div>
                }
                @foreach (var dia in Model.Dias)
                {
                    if (Model.SoloLectura)
                    {
                        <div class="cal-cell cal-cell--readonly">
                            <span class="cal-cell__day @(dia.EsHoy ? "is-today" : "")">@dia.Fecha.Day</span>
                            @foreach (var ev in dia.Eventos)
                            {
                                <span class="cal-chip cal-chip--@ev.Tipo.ToLowerInvariant()" title="@ev.Titulo (@ev.HoraInicio.ToString(@"hh\:mm")–@ev.HoraFin.ToString(@"hh\:mm"))">@ev.Titulo</span>
                            }
                        </div>
                    }
                    else
                    {
                        <a class="cal-cell" asp-action="AgregarEvento" asp-route-fecha="@dia.Fecha.ToString("yyyy-MM-dd")"
                           title="Agregar evento el @dia.Fecha.ToString("dd/MM/yyyy")">
                            <span class="cal-cell__day @(dia.EsHoy ? "is-today" : "")">@dia.Fecha.Day</span>
                            @foreach (var ev in dia.Eventos)
                            {
                                <span class="cal-chip cal-chip--@ev.Tipo.ToLowerInvariant()" title="@ev.Titulo">@(ev.Tipo == "Manual" ? (ev.NombrePropiedad ?? ev.Titulo) : ev.Titulo)</span>
                            }
                        </a>
                    }
                }
            </div>
        </section>

        <aside class="cal-events">
            <h2>Próximos eventos</h2>
            @if (Model.Proximos.Count == 0)
            {
                <p class="cal-event cal-event--empty">No hay eventos próximos</p>
            }
            @foreach (var ev in Model.Proximos)
            {
                <p class="cal-event">@ev.Fecha.ToString("d/M"): @ev.Titulo</p>
            }
        </aside>
    </div>
</div>
