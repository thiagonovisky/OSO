@using System.Globalization
@model List<OSO.Models.Evento>
@{
    ViewData["Title"] = "Calendario";
    var es = new CultureInfo("es-AR");
    var mes = (DateTime)ViewBag.Mes;
    var proximos = (List<OSO.Models.Evento>)ViewBag.Proximos;
    bool soloLectura = ViewBag.SoloLectura == true;
    string NombreMes(DateTime d) => es.TextInfo.ToTitleCase(d.ToString("MMMM", es));
    string[] dias = { "Lun", "Mar", "Mier", "Jue", "Vie", "Sab", "Dom" };
    int offset = ((int)mes.DayOfWeek + 6) % 7; // lunes = 0
    int diasMes = DateTime.DaysInMonth(mes.Year, mes.Month);
    var porDia = Model.GroupBy(e => e.Fecha.Day).ToDictionary(g => g.Key, g => g.ToList());
}

<div class="cal-page">
    <h1 class="cal-title">CALENDARIO</h1>

    @{
        var anterior = mes.AddMonths(-1);
        var siguiente = mes.AddMonths(1);
    }
    <div class="cal-layout">
            @* El selector de mes va en su propia fila, así "Próximos eventos" arranca a la altura de los días de la semana. *@
            <nav class="cal-nav" aria-label="Cambiar de mes">
                <a class="cal-nav__btn" asp-action="Calendario" asp-route-anio="@anterior.Year" asp-route-mes="@anterior.Month"
                   aria-label="Mes anterior (@NombreMes(anterior) @anterior.Year)">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <p class="cal-nav__current">@NombreMes(mes) @mes.Year</p>
                <a class="cal-nav__btn" asp-action="Calendario" asp-route-anio="@siguiente.Year" asp-route-mes="@siguiente.Month"
                   aria-label="Mes siguiente (@NombreMes(siguiente) @siguiente.Year)">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
            </nav>

        <section class="cal-grid-wrap" aria-label="Calendario de @NombreMes(mes) @mes.Year">
            <div class="cal-grid cal-grid--head">
                @foreach (var d in dias)
                {
                    <span>@d</span>
                }
            </div>
            <div class="cal-grid">
                @for (int i = 0; i < offset; i++)
                {
                    <div class="cal-cell cal-cell--empty"></div>
                }
                @for (int dia = 1; dia <= diasMes; dia++)
                {
                    var fecha = new DateTime(mes.Year, mes.Month, dia);
                    var claseDia = fecha == DateTime.Today ? "cal-cell__day is-today" : "cal-cell__day";
                    porDia.TryGetValue(dia, out var eventosDia);
                    if (soloLectura)
                    {
                        <div class="cal-cell cal-cell--readonly">
                            <span class="@claseDia">@dia</span>
                            @foreach (var ev in eventosDia ?? new List<OSO.Models.Evento>())
                            {
                                <span class="cal-chip" title="@($"{ev.Titulo} ({ev.HoraInicio:hh\\:mm}–{ev.HoraFin:hh\\:mm})")">@ev.Titulo</span>
                            }
                        </div>
                    }
                    else
                    {
                        <a class="cal-cell" asp-action="AgregarEvento" asp-route-fecha="@fecha.ToString("yyyy-MM-dd")"
                           title="Agregar evento el @fecha.ToString("dd/MM/yyyy")">
                            <span class="@claseDia">@dia</span>
                            @foreach (var ev in eventosDia ?? new List<OSO.Models.Evento>())
                            {
                                <span class="cal-chip" title="@ev.Titulo">@(ev.NombrePropiedad ?? ev.Titulo)</span>
                            }
                        </a>
                    }
                }
            </div>
        </section>

        <aside class="cal-events">
            <h2>Próximos eventos</h2>
            @if (proximos.Count == 0)
            {
                <p class="cal-event cal-event--empty">No hay eventos próximos</p>
            }
            @foreach (var ev in proximos)
            {
                <p class="cal-event">@ev.Fecha.ToString("d/M"): @ev.Titulo</p>
            }
        </aside>
    </div>
</div>
