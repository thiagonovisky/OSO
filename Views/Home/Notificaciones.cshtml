@model List<OSO.Models.Notificacion>
@{
    var notificaciones = Model ?? new List<OSO.Models.Notificacion>();
    int sinLeer = ViewBag.SinLeer as int? ?? 0;
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Notificaciones</h2>
    @if (notificaciones.Count > 0)
    {
        <p class="pagina-bajada">@(sinLeer == 0 ? "Estás al día: no hay avisos nuevos." : sinLeer == 1 ? "Tenés 1 aviso nuevo, marcado con un punto." : $"Tenés {sinLeer} avisos nuevos, marcados con un punto.")</p>

        <section class="panel">
            <ul class="notif-lista">
                @foreach (var n in notificaciones)
                {
                    <li class="notif @(n.Leida ? "" : "notif--nueva")">
                        <span class="notif__punto" aria-hidden="true"></span>
                        <div>
                            @if (!n.Leida)
                            {
                                <span class="visually-hidden">Nueva: </span>
                            }
                            <p class="notif__texto">@n.Texto</p>
                            <time class="notif__fecha" datetime="@n.FechaCreacion.ToString("yyyy-MM-ddTHH:mm")">@n.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</time>
                        </div>
                        <div class="notif__accion">
                            @* El aviso "el propietario cargó el contrato de <dirección>" lleva al contrato que sigue esperando que lo acepte. *@
                            @if (n.IdContratoParaAceptar.HasValue)
                            {
                                <a asp-action="VerContrato" asp-controller="Home" asp-route-idContrato="@n.IdContratoParaAceptar" asp-route-desde="notificaciones" class="btn btn-primary btn-sm">Ver contrato y aceptarlo</a>
                            }
                            else if (n.EsRecordatorioFacturas)
                            {
                                <a asp-action="MisGastos" asp-controller="Home" class="btn btn-secondary btn-sm">Ir a Mis gastos</a>
                            }
                            else if (n.IdGastoResponsable.HasValue && ViewBag.EsInquilino == true)
                            {
                                <a asp-action="MisGastos" asp-controller="Home" class="btn btn-success btn-sm">Ir a pagar</a>
                            }
                            else if (n.IdEmisor.HasValue)
                            {
                                <a asp-action="Mensajeria" asp-controller="Home" asp-route-con="@n.IdEmisor" class="btn btn-secondary btn-sm">Ver conversación</a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
    else
    {
        <div class="seccion-gastos gastos-vacio">
            <span class="bienvenida__icon"><partial name="_IconoMenu" model="@("Notificaciones")" /></span>
            <p class="gastos-vacio__titulo">No tenés notificaciones</p>
            <p>Acá te avisamos cuando haya un contrato para aceptar, un gasto para pagar o un mensaje nuevo.</p>
        </div>
    }
</div>
