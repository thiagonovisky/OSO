@model List<OSO.Models.Notificacion>
@{
    var contratosPendientes = ViewBag.ContratosPendientes as List<OSO.Models.Contratos> ?? new List<OSO.Models.Contratos>();
}

<h2>Notificaciones</h2>

@if (Model != null && Model.Count > 0)
{
    <ul class="list-group mt-3">
        @foreach (var n in Model)
        {
            <li class="list-group-item @(n.Leida ? "" : "fw-bold")">
                <div>@n.Texto</div>
                <small class="text-muted">@n.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                @{
                    // El aviso "el propietario cargó el contrato de <dirección>" lleva al contrato que sigue esperando que lo acepte.
                    var contratoDelAviso = n.Texto.StartsWith(OSO.Models.BD.TextoContratoCargado)
                        ? contratosPendientes.FirstOrDefault(c => !string.IsNullOrEmpty(c.Direccion) && n.Texto.Contains(c.Direccion))
                        : null;
                }
                @if (contratoDelAviso != null)
                {
                    <div>
                        <a asp-action="VerContrato" asp-controller="Home" asp-route-idContrato="@contratoDelAviso.IdContrato" asp-route-desde="notificaciones" class="btn btn-primary">Ver contrato y aceptarlo</a>
                    </div>
                }
                else if (n.Texto.StartsWith(OSO.Models.BD.TextoRecordatorioFacturas))
                {
                    <div><a asp-action="MisGastos" asp-controller="Home" class="btn">Ir a Mis gastos</a></div>
                }
                else if (n.IdGastoResponsable.HasValue && Context.Session.GetInt32("IdInquilino").HasValue)
                {
                    <div><a asp-action="MisGastos" asp-controller="Home" class="btn">Ir a pagar</a></div>
                }
                else if (n.IdEmisor.HasValue)
                {
                    <div><a asp-action="Mensajeria" asp-controller="Home" asp-route-con="@n.IdEmisor" class="btn">Ver conversación</a></div>
                }
            </li>
        }
    </ul>
}
else
{
    <p class="mt-3 text-center">No tenés notificaciones.</p>
}
