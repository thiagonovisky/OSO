@model OSO.Models.Contacto
@* Fila de contacto: se usa igual en la lista inicial y en la barra lateral del chat. *@
@{
    var activo = ViewBag.Activo as OSO.Models.Contacto;
}
<a class="msj-contact @(activo != null && activo.IdUsuario == Model.IdUsuario ? "is-active" : "")" href="@Url.Action("Mensajeria", new { con = Model.IdUsuario })">
    <partial name="_AvatarContacto" model="Model" />
    <span class="msj-contact__body">
        <span class="msj-contact__name">@Model.NombreCompleto</span>
        <span class="msj-contact__meta">
            <span class="msj-contact__last">@(Model.UltimoMensaje ?? "Sin mensajes todavía")</span>
            @if (Model.FechaUltimoMensaje != null)
            {
                <span class="msj-contact__time">@Model.HoraUltimoMensaje</span>
            }
            @if (Model.UltimoEsMio)
            {
                <svg class="msj-ticks @(Model.UltimoLeido ? "is-read" : "")" viewBox="0 0 24 14" aria-label="@(Model.UltimoLeido ? "Leído" : "Enviado")">
                    <path d="M1 7.5l4 4L13 3.5M9 10l1.5 1.5L18.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            }
            @if (Model.NoLeidos > 0)
            {
                <span class="msj-badge" aria-label="@Model.NoLeidos sin leer">@Model.NoLeidos</span>
            }
        </span>
    </span>
</a>
