@model OSO.Models.GastoPropiedad
@{
	var propiedades = ViewBag.Propiedades as List<OSO.Models.Propiedades>;
}

<h2>Agregar expensa extraordinaria</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


<form asp-action="AgregarExpensa" asp-controller="Home" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()

	<div class="mb-3">
		<label class="form-label">Propiedad</label>
		<select name="idPropiedad" class="form-control" required>
			<option value="">Seleccionar propiedad</option>
			@if (propiedades != null)
			{
				foreach (var propiedad in propiedades)
				{
					<option value="@propiedad.IdPropiedad">@propiedad.Direccion</option>
				}
			}
		</select>
	</div>

	<div class="factura-lector mb-3">
		<label class="form-label">Liquidación de expensas (opcional)</label>
		<input type="file" accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control" />
		<button type="button" class="btn btn-secondary mt-1 btn-leer-factura" data-url="@Url.Action("LeerFactura", "Home")" data-tipo="Expensas extraordinarias" data-campo-monto="montoExtraordinarias" data-campo-vencimiento="FechaVencimiento">Leer monto y vencimiento</button>
		<small class="factura-estado d-block"></small>
	</div>

	<div class="mb-3">
		<label for="monto" class="form-label">Monto de la expensa extraordinaria</label>
		<input id="monto" name="montoExtraordinarias" type="number" step="0.01" min="0.01" required class="form-control" />
		<small>Se reparte según lo que dice el contrato: a cada uno le aparece su parte en Mis gastos.</small>
	</div>

	<div class="mb-3">
		<label asp-for="FechaAlta" class="form-label">Fecha de alta</label>
		<input asp-for="FechaAlta" type="date" class="form-control" required />
	</div>

	<div class="mb-3">
		<label asp-for="FechaVencimiento" class="form-label">Fecha de vencimiento</label>
		<input asp-for="FechaVencimiento" type="date" class="form-control" required />
	</div>

	<div class="mb-3">
		<label asp-for="Aclaracion" class="form-label">Aclaración</label>
		<textarea asp-for="Aclaracion" class="form-control" rows="3" maxlength="255"></textarea>
	</div>

	<button type="submit" class="btn btn-primary">Guardar expensa extraordinaria</button>
	<a asp-action="Expensas" asp-controller="Home" class="btn btn-primary">Cancelar</a>
</form>

@section Scripts {
    <script src="~/js/factura.js" asp-append-version="true"></script>
}
