@model OSO.Models.GastoPropiedad
@{
	var propiedades = ViewBag.Propiedades as List<OSO.Models.Propiedades>;
}

<h2>Agregar Expensa</h2>

<form asp-action="AgregarExpensa" asp-controller="Home" method="post" enctype="multipart/form-data">
	@Html.AntiForgeryToken()

	<div class="mb-3">
		<label class="form-label">Propiedad</label>
		<select name="idPropiedad" class="form-control" required>
			<option value="">Seleccionar propiedad</option>
			@if (propiedades != null)
			{
				foreach (var propiedad in propiedades)
				{
					<option value="@propiedad.IdPropiedad">@propiedad.Direccion</option>
				}
			}
		</select>
	</div>

	<div class="mb-3">
		<label asp-for="Monto" class="form-label">Monto</label>
		<input asp-for="Monto" type="number" step="0.01" min="0" class="form-control" required />
	</div>

	<div class="mb-3">
		<label asp-for="FechaAlta" class="form-label">Fecha de alta</label>
		<input asp-for="FechaAlta" type="date" class="form-control" required />
	</div>

	<div class="mb-3">
		<label asp-for="FechaVencimiento" class="form-label">Fecha de vencimiento</label>
		<input asp-for="FechaVencimiento" type="date" class="form-control" required />
	</div>

	<div class="mb-3">
		<label asp-for="Aclaracion" class="form-label">Aclaración</label>
		<textarea asp-for="Aclaracion" class="form-control" rows="3"></textarea>
	</div>

	<button type="submit" class="btn btn-primary">Guardar Expensa</button>
	<a asp-action="Expensas" asp-controller="Home" class="btn btn-secondary">Cancelar</a>
</form>
