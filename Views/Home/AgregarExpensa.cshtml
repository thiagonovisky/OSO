@model OSO.Models.GastoPropiedad
@{
    var propiedades = ViewBag.Propiedades as List<OSO.Models.Propiedades>;
    int? idPropiedadElegida = ViewBag.IdPropiedadElegida as int?;
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Agregar expensa extraordinaria</h2>
    <p class="pagina-bajada">Se reparte según lo que dice el contrato: a cada uno le aparece su parte en Mis gastos.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <form asp-action="AgregarExpensa" asp-controller="Home" method="post" enctype="multipart/form-data" class="panel form-panel">
        @Html.AntiForgeryToken()

        <div class="campo">
            <label for="idPropiedad">Propiedad</label>
            <select id="idPropiedad" name="idPropiedad" required>
                <option value="">Elegí la propiedad</option>
                @if (propiedades != null)
                {
                    foreach (var propiedad in propiedades)
                    {
                        <option value="@propiedad.IdPropiedad" selected="@(propiedad.IdPropiedad == idPropiedadElegida)">@propiedad.Direccion</option>
                    }
                }
            </select>
        </div>

        <div class="campo factura-lector">
            <label for="liquidacion">Liquidación de expensas (opcional)</label>
            <div class="factura-lector__fila">
                <input type="file" id="liquidacion" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                <button type="button" class="btn btn-secondary btn-leer-factura" data-url="@Url.Action("LeerFactura", "Home")" data-tipo="Expensas extraordinarias" data-campo-monto="montoExtraordinarias" data-campo-vencimiento="FechaVencimiento">Leer monto y vencimiento</button>
            </div>
            <small class="factura-estado" role="status"></small>
        </div>

        <div class="campos-fila">
            <div class="campo">
                <label for="monto">Monto de la expensa</label>
                <input id="monto" name="montoExtraordinarias" type="number" step="0.01" min="0.01" required />
            </div>
            <div class="campo">
                <label asp-for="FechaVencimiento">Fecha de vencimiento</label>
                <input asp-for="FechaVencimiento" type="date" required />
                <small class="campo__ayuda">Con la liquidación se completa solo; si no, te proponemos @OSO.Models.GastoPropiedad.DiasVencimientoPropuesto días desde hoy.</small>
            </div>
        </div>

        <div class="campo">
            <label asp-for="Aclaracion">Aclaración (opcional)</label>
            <textarea asp-for="Aclaracion" rows="3" maxlength="255"></textarea>
        </div>

        <div class="form-acciones">
            <a asp-action="Expensas" asp-controller="Home" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar expensa</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/factura.js" asp-append-version="true"></script>
}
