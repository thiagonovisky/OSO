@model List<OSO.Models.GastoPropiedad>
@{
    var pendientesContrato = ViewBag.PendientesContrato as List<OSO.Models.PendienteContrato> ?? new List<OSO.Models.PendienteContrato>();
}

<h2>Mis gastos</h2>

@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

@if ((Model != null && Model.Count > 0) || pendientesContrato.Count > 0)
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Propiedad</th>
                <th>Gasto</th>
                <th>Estado</th>
                <th>Vencimiento</th>
                <th>Total del gasto</th>
                <th>Tu parte</th>
                <th>Parte del propietario</th>
                <th>Fecha de pago</th>
                <th>Comprobante</th>
            </tr>
        </thead>
        <tbody>
            @* Meses de los gastos que el contrato pone a tu cargo y que todavía no pagaste: el monto lo cargás vos al pagar. *@
            @foreach (var pendiente in pendientesContrato)
            {
                <tr>
                    <td>@pendiente.NombrePropiedad</td>
                    <td>@pendiente.TipoGasto <small>(@pendiente.Periodo.ToString("MMMM yyyy"))</small></td>
                    <td>A pagar</td>
                    <td>-</td>
                    <td colspan="2">Lo cargás al pagar (100% a tu cargo)</td>
                    <td>-</td>
                    <td>-</td>
                    <td>
                        <form asp-action="PagarPendienteContrato" asp-controller="Home" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idPropiedad" value="@pendiente.IdPropiedad" />
                            <input type="hidden" name="idGasto" value="@pendiente.IdGasto" />
                            <input type="hidden" name="periodo" value="@pendiente.Periodo.ToString("yyyy-MM-dd")" />
                            <input type="number" name="monto" min="0.01" step="0.01" placeholder="Monto $" class="form-control form-control-sm" required />
                            <input type="file" name="comprobanteArchivo" accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control form-control-sm" required />
                            <button type="submit" class="btn btn-success btn-sm">Pagar</button>
                        </form>
                    </td>
                </tr>
            }

            @foreach (var gasto in Model ?? new List<OSO.Models.GastoPropiedad>())
            {
                bool pagado = gasto.MontoPagado >= gasto.MontoResponsable;
                <tr>
                    <td>@gasto.NombrePropiedad</td>
                    <td>@gasto.TipoGasto <small>(@gasto.Periodo.ToString("MMMM yyyy"))</small></td>
                    <td>@(pagado ? "Pagado" : gasto.FechaVencimiento.Date < DateTime.Today ? "Vencido" : "A pagar")</td>
                    <td>@gasto.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>$@gasto.Monto</td>
                    <td><strong class="mi-parte">$@gasto.MontoResponsable</strong></td>
                    <td>$@gasto.MontoPropietario</td>
                    <td>@(gasto.FechaPago.HasValue ? gasto.FechaPago.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        @if (!pagado)
                        {
                            <form asp-action="PagarGasto" asp-controller="Home" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idGastoResponsable" value="@gasto.IdGastoResponsable" />
                                <input type="file" name="comprobanteArchivo" accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-success btn-sm">Pagar</button>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(gasto.Comprobante))
                        {
                            <a href="@Url.Content("~/comprobantes/" + gasto.Comprobante)" target="_blank" class="btn">Ver comprobante</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3 text-center">@(ViewBag.TieneContrato == true ? "No tenés gastos a tu cargo." : "Todavía no hay un contrato confirmado, por eso no hay gastos para mostrar.")</p>
}
