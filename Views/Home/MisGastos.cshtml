@model List<OSO.Models.GastoPropiedad>
@{
    var pendientesRecientes = ViewBag.PendientesRecientes as List<OSO.Models.PendienteContrato> ?? new List<OSO.Models.PendienteContrato>();
    var pendientesAnteriores = ViewBag.PendientesAnteriores as List<OSO.Models.PendienteContrato> ?? new List<OSO.Models.PendienteContrato>();
    var gastosAPagar = ViewBag.GastosAPagar as List<OSO.Models.GastoPropiedad> ?? new List<OSO.Models.GastoPropiedad>();
    var gastosPagados = ViewBag.GastosPagados as List<OSO.Models.GastoPropiedad> ?? new List<OSO.Models.GastoPropiedad>();
    bool esPropietario = ViewBag.EsPropietario == true;
}

<h2 class="gastos-title">Mis gastos</h2>

@if (esPropietario || ViewBag.TieneContrato == true)
{
    <div class="pagina-acciones">
        <a asp-action="CargarMes" asp-controller="Home" class="btn btn-primary">Cargar facturas del mes</a>
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <p class="aviso-pagina" role="status">@TempData["Mensaje"]</p>
}

@if (ViewBag.HayGastos == true)
{
    <div class="seccion-gastos">
    @* A pagar: lo que está sin pagar y los últimos meses de los gastos que el contrato pone a tu cargo. El monto de estos últimos lo cargás vos al pagar. *@
    <h3>A pagar</h3>
    @if (pendientesRecientes.Count > 0 || gastosAPagar.Count > 0)
    {
        <div class="tabla-wrap"><table class="table">
            <thead><partial name="_EncabezadoMisGastos" /></thead>
            <tbody>
                @foreach (var pendiente in pendientesRecientes)
                {
                    <partial name="_FilaPendiente" model="pendiente" />
                }
                @foreach (var gasto in gastosAPagar)
                {
                    <partial name="_FilaGasto" model="gasto" />
                }
            </tbody>
        </table></div>
    }
    else
    {
        <p class="seccion-gastos__vacio">No tenés nada para pagar por ahora.</p>
    }

    @if (pendientesAnteriores.Count > 0)
    {
        <details>
            <summary><strong>Meses anteriores sin pagar (@pendientesAnteriores.Count)</strong></summary>
            <div class="tabla-wrap"><table class="table">
                <thead><partial name="_EncabezadoMisGastos" /></thead>
                <tbody>
                    @foreach (var pendiente in pendientesAnteriores)
                    {
                        <partial name="_FilaPendiente" model="pendiente" />
                    }
                </tbody>
            </table></div>
        </details>
    }

    <h3>Historial de pagos</h3>
    @if (gastosPagados.Count > 0)
    {
        <div class="tabla-wrap"><table class="table">
            <thead><partial name="_EncabezadoMisGastos" /></thead>
            <tbody>
                @foreach (var gasto in gastosPagados)
                {
                    <partial name="_FilaGasto" model="gasto" />
                }
            </tbody>
        </table></div>
    }
    else
    {
        <p class="seccion-gastos__vacio">Todavía no hay gastos pagados.</p>
    }
    </div>
}
else
{
    <div class="seccion-gastos gastos-vacio">
        <span class="bienvenida__icon"><partial name="_IconoMenu" model="@("MisGastos")" /></span>
        <p class="gastos-vacio__titulo">@(esPropietario || ViewBag.TieneContrato == true ? "No tenés gastos a tu cargo" : "Todavía no hay un contrato confirmado")</p>
        <p>@(esPropietario
            ? "Cuando un contrato te ponga a cargo de un servicio o de una expensa extraordinaria, lo vas a ver acá para pagarlo."
            : ViewBag.TieneContrato == true
                ? "Cuando haya un gasto a tu cargo según el contrato, lo vas a ver acá para pagarlo."
                : "Cuando aceptes el contrato de tu alquiler, acá vas a ver los servicios y expensas que te tocan pagar.")</p>
        <a asp-action="Propiedades" asp-controller="Home" class="btn btn-secondary">@(esPropietario ? "Ver mis propiedades" : "Ver mi alquiler")</a>
    </div>
}

@section Scripts {
    <script src="~/js/factura.js" asp-append-version="true"></script>
}
