@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form class="auth-form" action='@Url.Action("AgregarP", "Home")' method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="form-row">
        <label for="direccion">Dirección</label>
        <input type="text" id="direccion" name="direccion" maxlength="50" required />
     </div>

    <div class="form-row">
        <label for="superficie">Superficie</label>
        <input type="number" id="superficie" name="superficie" min="1" required />
    </div>

    <div class="form-row">
        <label for="ambientes">Cantidad de Ambientes</label>
        <input type="number" id="ambientes" name="ambientes" min="1" required />
    </div>

    <div class="form-row">
			<label for="foto">Foto</label>
			<input type="file" id="foto" name="foto" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" />
	</div>

    <div class="form-row">
        <label for="estado">Estado</label>
        <select id="estado" name="estado" required>
            <option value="Desocupado">Desocupado</option>
            <option value="Ocupado">Ocupado</option>
        </select>
    </div>

    <div class="form-row">
        <label for="FechaDeAlta">Fecha de Alta</label>
        <input type="date" id="FechaDeAlta" name="FechaDeAlta" required />
    </div>

    <div class="form-row">
        <button type="submit">Agregar Propiedad</button>
    </div>
</form>