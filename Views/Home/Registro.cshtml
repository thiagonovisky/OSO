@{
    bool desdeInvitacion = !string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string);
}
<div class="auth-page">
<h1>Registrate</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form action='@Url.Action("Registrar", "Home")' method="post" enctype="multipart/form-data">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div>
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" required />
    </div>
    <div>
        <label for="apellido">Apellido:</label>
        <input type="text" id="apellido" name="apellido" required />
    </div>
    <div>
        <label for="correo">Correo electrónico:</label>
        <input type="email" id="correo" name="correo" required />
    </div>
    <div>
        <label for="telefono">Teléfono:</label>
        <div class="phone-field">
            <select id="codigoPais" name="codigoPais" aria-label="País">
                @foreach (var pais in OSO.Models.TelefonoFormato.Paises)
                {
                    <option value="@pais.Codigo" data-digitos="@pais.Digitos" data-ejemplo="@pais.Ejemplo">@pais.Nombre (+@pais.Codigo)</option>
                }
            </select>
            <input type="tel" id="telefono" name="telefono" required inputmode="numeric"
                   placeholder="11-2345-6789"
                   title="Ingresá el número con código de área; los guiones se agregan solos" />
        </div>
    </div>
    <div>
        <label for="contrasena">Contraseña:</label>
        <input type="password" id="contrasena" name="contrasena" required minlength="8" />
        <ul class="password-rules" id="passwordRules">
            <li data-rule="len">Mínimo 8 caracteres</li>
            <li data-rule="special">Al menos 1 carácter especial (ej: ! * # $ %)</li>
        </ul>
    </div>
    <div>
        <label for="confirmarContrasena">Confirmar Contraseña:</label>
        <input type="password" id="confirmarContrasena" name="confirmarContrasena" required />
    </div>
    <div>
        <label for="fotoPerfil">Foto de perfil:</label>
        <input type="file" id="fotoPerfil" name="fotoPerfil" accept="image/*" />
    </div>
    @if (desdeInvitacion)
    {
        <input type="hidden" name="esPropietario" value="false" />
        <p>Te vas a registrar como <strong>inquilino</strong> de la propiedad a la que te invitaron.</p>
    }
    else
    {
        <div class="auth-roles">
            <input type="radio" id="inquilino" name="esPropietario" value="false" checked />
            <label for="inquilino">Soy inquilino</label>

            <input type="radio" id="propietario" name="esPropietario" value="true" />
            <label for="propietario">Soy propietario</label>
        </div>
    }
    <div class="auth-actions">
        <button type="submit">Registrarse</button>
        <button type="reset">Limpiar</button>
    </div>
</form>

<p class="auth-switch">¿Ya tenés cuenta? <a asp-action="Login" asp-controller="Home" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn">Iniciá sesión</a></p>
</div>
