@model List<OSO.Models.FilaCargarMes>
@{
    var mesesRecientes = ViewBag.MesesRecientes as List<OSO.Models.MesCargarMes> ?? new List<OSO.Models.MesCargarMes>();
    var mesesAnteriores = ViewBag.MesesAnteriores as List<OSO.Models.MesCargarMes> ?? new List<OSO.Models.MesCargarMes>();
    bool esPropietario = ViewBag.EsPropietario == true;
    string elOtro = esPropietario ? "el inquilino" : "el propietario";
}

<h2 class="gastos-title">Cargar servicios</h2>

@if (TempData["Success"] != null)
{
    <p class="aviso-pagina" role="status">@TempData["Success"]</p>
}
@if (!string.IsNullOrEmpty(ViewBag.Resumen as string))
{
    <p class="aviso-pagina" role="status">@ViewBag.Resumen</p>
}
@if (ViewBag.HayErrores == true)
{
    <div class="alert alert-danger">Algunas filas no se guardaron. Revisá los montos marcados.</div>
}

@if (Model.Count == 0)
{
    <div class="seccion-gastos gastos-vacio">
        <p class="gastos-vacio__titulo">Estás al día: no hay servicios para cargar</p>
        <p>@(esPropietario
            ? "Cuando empiece un mes de un contrato con servicios mensuales, vas a poder cargar sus facturas acá."
            : "Cuando empiece un mes de tu contrato con servicios mensuales, vas a poder cargar acá las facturas que te lleguen.")</p>
        <a asp-action="MisGastos" asp-controller="Home" class="btn btn-secondary">Ver mis gastos</a>
    </div>
}
else
{
    <form asp-action="GuardarMes" asp-controller="Home" method="post" enctype="multipart/form-data" class="seccion-gastos cargar-mes" id="cargar-mes">
        @Html.AntiForgeryToken()
        <p>Cargá las facturas que te llegaron, aunque las pague @elOtro: cargar no es pagar. Cada uno paga después su parte desde Mis gastos.
            Las filas que dejes vacías siguen pendientes y también las puede cargar @elOtro.</p>

        <section class="cargar-mes__facturas" aria-labelledby="titulo-facturas">
            <label class="cargar-mes__zona" id="zona-facturas">
                <strong id="titulo-facturas">Soltá acá tus facturas</strong>
                <span>o hacé clic para elegirlas. Hasta 10 por vez, en PDF o foto. La IA completa las filas y vos revisás antes de guardar. Cada factura queda guardada con su gasto.</span>
                <input type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" id="archivos-facturas" class="visually-hidden"
                       data-url="@Url.Action("LeerFacturaParaMes", "Home")" />
            </label>
            <p class="cargar-mes__estado" id="estado-facturas" role="status"></p>
            <div id="para-ubicar" hidden>
                <h3>Facturas para ubicar</h3>
                <p>No pudimos saber con seguridad a qué fila va cada una. Elegí la fila y se completa.</p>
                <ul class="cargar-mes__lista" id="lista-para-ubicar"></ul>
            </div>
            <div id="sin-leer" hidden>
                <h3>Facturas sin leer</h3>
                <ul class="cargar-mes__lista" id="lista-sin-leer"></ul>
                <button type="button" class="btn btn-secondary btn-sm" id="reintentar-facturas" hidden>Reintentar</button>
            </div>
        </section>

        @foreach (var mes in mesesRecientes)
        {
            <partial name="_TablaCargarMes" model="mes" />
        }

        @if (mesesAnteriores.Count > 0)
        {
            <details>
                <summary><strong>Meses anteriores (@ViewBag.CantidadAnteriores)</strong></summary>
                @foreach (var mes in mesesAnteriores)
                {
                    <partial name="_TablaCargarMes" model="mes" />
                }
            </details>
        }

        <div class="oso-center-row">
            <button type="submit" class="btn btn-primary">Guardar los completos</button>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/cargar-mes.js" asp-append-version="true"></script>
}
