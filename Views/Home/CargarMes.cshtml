@model List<OSO.Models.FilaCargarMes>
@{
    var errores = ViewBag.Errores as Dictionary<string, string> ?? new Dictionary<string, string>();
    var enviadas = ViewBag.Enviadas as Dictionary<string, OSO.Models.FilaEnviada> ?? new Dictionary<string, OSO.Models.FilaEnviada>();
    var filas = Model ?? new List<OSO.Models.FilaCargarMes>();
    bool esPropietario = ViewBag.EsPropietario == true;
    string elOtro = esPropietario ? "el inquilino" : "el propietario";

    // Mismo criterio que "Mis gastos": los últimos meses abiertos, los anteriores plegados.
    var desdeReciente = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-(OSO.Models.PendienteContrato.MesesRecientes - 1));
    var recientes = filas.Where(f => f.Periodo >= desdeReciente).GroupBy(f => f.Periodo).ToList();
    var anteriores = filas.Where(f => f.Periodo < desdeReciente).GroupBy(f => f.Periodo).ToList();
    int indice = 0;

    void TablaMes(IGrouping<DateTime, OSO.Models.FilaCargarMes> mes)
    {
        <h3 class="cargar-mes__titulo">@OSO.Models.Formato.Mes(mes.Key)</h3>
        <div class="tabla-wrap"><table class="table cargar-mes__tabla">
            <thead>
                <tr>
                    <th>Propiedad</th>
                    <th>Servicio</th>
                    <th>Quién paga</th>
                    <th class="col-monto">Monto</th>
                    <th>Vence</th>
                    <th><span class="visually-hidden">Factura</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in mes)
                {
                    int i = indice++;
                    enviadas.TryGetValue(fila.Clave, out var enviada);
                    errores.TryGetValue(fila.Clave, out var error);
                    <tr data-clave="@fila.Clave" data-propiedad="@fila.IdPropiedad" data-servicio="@fila.TipoGasto"
                        data-periodo="@fila.Periodo.ToString("yyyy-MM-01")" data-direccion="@fila.NombrePropiedad">
                        <td data-label="Propiedad">@fila.NombrePropiedad</td>
                        <td data-label="Servicio"><strong>@fila.TipoGasto</strong></td>
                        <td data-label="Quién paga">
                            @if (fila.LaPagaElOtro)
                            {
                                @* Que no se confunda con algo a pagar: cargarla no le genera nada a quien la carga. *@
                                <span class="quien-paga quien-paga--otro">@fila.QuienPaga</span>
                                <small class="celda-sub">Vos solo cargás el monto</small>
                            }
                            else
                            {
                                <span class="quien-paga">@fila.QuienPaga</span>
                            }
                        </td>
                        <td data-label="Monto" class="col-monto">
                            @* filas.Index: al enviar, las filas vacías no mandan nada y los índices quedan salteados. *@
                            <input type="hidden" name="filas.Index" value="@i" />
                            <input type="hidden" name="filas[@i].IdPropiedad" value="@fila.IdPropiedad" />
                            <input type="hidden" name="filas[@i].IdGasto" value="@fila.IdGasto" />
                            <input type="hidden" name="filas[@i].Periodo" value="@fila.Periodo.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="filas[@i].IncluidoEn" value="@enviada?.IncluidoEn?.ToString("yyyy-MM-dd")" class="campo-incluido" />
                            <input type="number" name="filas[@i].Monto" step="0.01" min="0.01" class="form-control form-control-sm campo-monto"
                                   value="@OSO.Models.Formato.ParaInput(enviada?.Monto)"
                                   placeholder="@(fila.MontoSugerido.HasValue ? "~" + OSO.Models.Formato.Numero(fila.MontoSugerido, "N0") : "")"
                                   title="@(fila.MontoSugerido.HasValue ? "El mes anterior fue " + OSO.Models.Formato.Pesos(fila.MontoSugerido) : "")"
                                   aria-label="Monto de @fila.TipoGasto en @fila.NombrePropiedad" />
                            <small class="celda-sub cargar-mes__incluido" hidden></small>
                            @if (error != null)
                            {
                                <small class="text-danger d-block">@error</small>
                            }
                        </td>
                        <td data-label="Vence">
                            <input type="date" name="filas[@i].Vencimiento" class="form-control form-control-sm campo-vencimiento"
                                   value="@enviada?.Vencimiento?.ToString("yyyy-MM-dd")" aria-label="Vencimiento de @fila.TipoGasto en @fila.NombrePropiedad" />
                        </td>
                        <td class="cargar-mes__factura">
                            <small class="celda-sub cargar-mes__origen"></small>
                            @* La factura se guarda con el gasto. Al soltar facturas arriba, cada una se adjunta sola a su fila. *@
                            <label class="cargar-mes__adjuntar">
                                <input type="file" name="filas[@i].Factura" accept=".pdf,.jpg,.jpeg,.png,.webp" class="visually-hidden campo-factura"
                                       aria-label="Factura de @fila.TipoGasto en @fila.NombrePropiedad" />
                                <span class="cargar-mes__adjuntar-texto">Adjuntar factura</span>
                            </label>
                            @if (enviada?.Factura != null && error != null)
                            {
                                <small class="text-warning d-block">Volvé a adjuntar la factura (@enviada.Factura.FileName).</small>
                            }
                            else if (fila.ElOtroPagaAlgo)
                            {
                                <small class="celda-sub cargar-mes__aviso-factura">Adjuntala así @fila.ElOtro puede ver de dónde sale el monto.</small>
                            }
                            <button type="button" class="cargar-mes__marcar-incluido">
                                Marcar como incluido en otra factura
                                <small class="cargar-mes__marcar-ayuda">(si el servicio es bimestral)</small>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
}

<h2 class="gastos-title">Cargar servicios</h2>

@if (TempData["Success"] != null)
{
    <p class="aviso-pagina" role="status">@TempData["Success"]</p>
}
@if (!string.IsNullOrEmpty(ViewBag.Resumen as string))
{
    <p class="aviso-pagina" role="status">@ViewBag.Resumen</p>
}
@if (errores.Count > 0)
{
    <div class="alert alert-danger">Algunas filas no se guardaron. Revisá los montos marcados.</div>
}

@if (filas.Count == 0)
{
    <div class="seccion-gastos gastos-vacio">
        <p class="gastos-vacio__titulo">Estás al día: no hay servicios para cargar</p>
        <p>@(esPropietario
            ? "Cuando empiece un mes de un contrato con servicios mensuales, vas a poder cargar sus facturas acá."
            : "Cuando empiece un mes de tu contrato con servicios mensuales, vas a poder cargar acá las facturas que te lleguen.")</p>
        <a asp-action="MisGastos" asp-controller="Home" class="btn btn-secondary">Ver mis gastos</a>
    </div>
}
else
{
    <form asp-action="GuardarMes" asp-controller="Home" method="post" enctype="multipart/form-data" class="seccion-gastos cargar-mes" id="cargar-mes">
        @Html.AntiForgeryToken()
        <p>Cargá las facturas que te llegaron, aunque las pague @elOtro: cargar no es pagar. Cada uno paga después su parte desde Mis gastos.
            Las filas que dejes vacías siguen pendientes y también las puede cargar @elOtro.</p>

        <section class="cargar-mes__facturas" aria-labelledby="titulo-facturas">
            <label class="cargar-mes__zona" id="zona-facturas">
                <strong id="titulo-facturas">Soltá acá tus facturas</strong>
                <span>o hacé clic para elegirlas. Hasta 10 por vez, en PDF o foto. La IA completa las filas y vos revisás antes de guardar. Cada factura queda guardada con su gasto.</span>
                <input type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.webp" id="archivos-facturas" class="visually-hidden"
                       data-url="@Url.Action("LeerFacturaParaMes", "Home")" />
            </label>
            <p class="cargar-mes__estado" id="estado-facturas" role="status"></p>
            <div id="para-ubicar" hidden>
                <h3>Facturas para ubicar</h3>
                <p>No pudimos saber con seguridad a qué fila va cada una. Elegí la fila y se completa.</p>
                <ul class="cargar-mes__lista" id="lista-para-ubicar"></ul>
            </div>
            <div id="sin-leer" hidden>
                <h3>Facturas sin leer</h3>
                <ul class="cargar-mes__lista" id="lista-sin-leer"></ul>
                <button type="button" class="btn btn-secondary btn-sm" id="reintentar-facturas" hidden>Reintentar</button>
            </div>
        </section>

        @foreach (var mes in recientes)
        {
            TablaMes(mes);
        }

        @if (anteriores.Count > 0)
        {
            <details>
                <summary><strong>Meses anteriores (@anteriores.Sum(m => m.Count()))</strong></summary>
                @foreach (var mes in anteriores)
                {
                    TablaMes(mes);
                }
            </details>
        }

        <div class="oso-center-row">
            <button type="submit" class="btn btn-primary">Guardar los completos</button>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/cargar-mes.js" asp-append-version="true"></script>
}
