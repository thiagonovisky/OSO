@model OSO.Models.RevisionContrato
@{
    var c = Model.Contrato;
    bool comoPropietario = ViewBag.ComoPropietario == true;
    bool pendiente = c.Estado == "PendienteInquilino";
    bool paraAceptar = pendiente && !comoPropietario;
    bool terminado = c.Estado == "Finalizado";
    string pillEstado = pendiente ? "pagar" : terminado ? "neutro" : "pagado";
    string textoEstado = comoPropietario && pendiente ? "Esperando al inquilino" : c.EstadoParaInquilino;
}

<div class="pagina">
    <h2 class="pagina-titulo">Contrato de alquiler</h2>
    <p class="pagina-bajada">
        <strong>@Model.Propiedad.Direccion</strong> · <span class="estado-pill estado-pill--@pillEstado">@textoEstado</span>
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Success"]</div>
    }

    @if (paraAceptar)
    {
        <p class="aviso-pagina">
            Tu propietario cargó este contrato y espera que lo aceptes. Revisá los datos y quién paga cada gasto; si está todo bien, aceptalo al final de la página.
        </p>
    }
    else if (comoPropietario && pendiente)
    {
        <p class="aviso-pagina">
            Le enviaste este contrato al inquilino. Queda vigente cuando lo acepte; mientras tanto no se puede modificar.
        </p>
    }

    @if (terminado && !comoPropietario)
    {
        <div class="alert alert-warning">
            <strong>Este contrato terminó el @Formato.Fecha(c.FechaFinReal)</strong> · Motivo: @OSO.Models.ReglasContrato.NombreMotivoFin(c.MotivoFin).
            @if (!string.IsNullOrWhiteSpace(c.DescripcionFin))
            {
                <br /><span>Lo que explicó el propietario: @c.DescripcionFin</span>
            }
            <br /><span>Ya no estás vinculado a la propiedad. Seguís viendo el contrato y tus gastos hasta esa fecha.</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(c.DisconformidadInquilino))
        {
            <section class="panel">
                <h3>Constancia de disconformidad</h3>
                <p class="panel__nota">Enviada el @c.FechaDisconformidad?.ToString("dd/MM/yyyy HH:mm")</p>
                <p>@c.DisconformidadInquilino</p>
            </section>
        }
        else if (c.MotivoFin != OSO.Models.ReglasContrato.FinDePlazo)
        {
            <form asp-action="DejarDisconformidad" asp-controller="Home" method="post" class="panel form-panel"
                  onsubmit="return confirm('La constancia se guarda una sola vez y no se puede editar. ¿Enviarla?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idContrato" value="@c.IdContrato" />
                <div class="campo">
                    <label for="texto">Dejar constancia de disconformidad</label>
                    <span class="campo__ayuda">No cambia la terminación, pero queda registrada y la ven los dos. Se puede dejar una sola vez y no se edita.</span>
                    <textarea name="texto" id="texto" rows="4" maxlength="1000" required></textarea>
                </div>
                <div class="form-acciones">
                    <button type="submit" class="btn btn-primary">Enviar constancia</button>
                </div>
            </form>
        }
    }

    <section class="panel">
        <div class="panel__cabecera">
            <h3>Datos del contrato</h3>
            @if (!string.IsNullOrEmpty(c.ArchivoContrato))
            {
                <a asp-action="DescargarContrato" asp-controller="Home" asp-route-idContrato="@c.IdContrato" target="_blank" class="btn btn-secondary btn-sm">Ver el archivo del contrato</a>
            }
        </div>
        <dl class="datos">
            <div><dt>Inicio</dt><dd>@Formato.Fecha(c.FechaInicio)</dd></div>
            <div><dt>Fin</dt><dd>@Formato.Fecha(c.FechaFin)</dd></div>
            <div><dt>Alquiler inicial</dt><dd>@Formato.Numero(c.MontoAlquiler) @c.Moneda</dd></div>
            <div><dt>Vence el día</dt><dd>@Formato.Dato(c.DiaVencimiento)</dd></div>
            <div><dt>Ajuste</dt><dd>@c.DescripcionAjuste</dd></div>
            <div><dt>Medio de pago</dt><dd>@Formato.Dato(c.MedioPago)</dd></div>
            <div><dt>Punitorio diario</dt><dd>@Formato.Dato(c.PunitorioDiario, "%")</dd></div>
            <div><dt>Depósito</dt><dd>@c.DepositoTexto</dd></div>
            <div><dt>Garantía</dt><dd>@Formato.Dato(c.TipoGarantia)</dd></div>
            <div><dt>Preaviso para rescindir</dt><dd>@Formato.Dato(c.PreavisoRescisionDias, " días")</dd></div>
            <div><dt>Régimen legal</dt><dd>@OSO.Models.ReglasContrato.NombreRegimen(c.RegimenLegal)</dd></div>
        </dl>
    </section>

    <section class="panel">
        <h3>Quién paga cada gasto</h3>
        <div class="tabla-wrap"><table class="table">
            <thead>
                <tr><th>Gasto</th><th>Lo paga</th><th>Cláusula del contrato</th></tr>
            </thead>
            <tbody>
                @foreach (var regla in Model.Reglas)
                {
                    <tr>
                        <td><strong>@regla.TipoGasto</strong></td>
                        <td data-label="Lo paga">@(comoPropietario ? (regla.Responsable == "Compartido" ? $"Compartido ({Formato.Numero(regla.PorcentajeInquilino, "0.##")}% inquilino)" : regla.Responsable) : regla.QuienPagaParaInquilino)</td>
                        <td data-label="Cláusula" class="celda-nota">@(string.IsNullOrEmpty(regla.TextoClausula) ? "—" : regla.TextoClausula)</td>
                    </tr>
                }
            </tbody>
        </table></div>
    </section>

    @if (paraAceptar)
    {
        <section class="panel panel--destacado">
            <h3>¿Está todo bien?</h3>
            <p class="panel__nota">Al aceptarlo, el contrato queda vigente y tus gastos aparecen en Mis gastos según quién paga cada uno.</p>
            <div class="form-acciones">
                @if (ViewBag.VolverANotificaciones == true)
                {
                    <a asp-action="Notificaciones" asp-controller="Home" class="btn btn-secondary">Volver a notificaciones</a>
                }
                else
                {
                    <a asp-action="Propiedades" asp-controller="Home" class="btn btn-secondary">Volver</a>
                }
                <form asp-action="AceptarContrato" asp-controller="Home" method="post" class="form-en-linea">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idContrato" value="@c.IdContrato" />
                    <button type="submit" class="btn btn-primary">Aceptar contrato</button>
                </form>
            </div>
        </section>
    }
    else
    {
        <div class="form-acciones form-acciones--centro">
            @if (comoPropietario)
            {
                <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@Model.Propiedad.IdPropiedad" class="btn btn-secondary">Volver</a>
            }
            else if (ViewBag.VolverANotificaciones == true)
            {
                <a asp-action="Notificaciones" asp-controller="Home" class="btn btn-secondary">Volver a notificaciones</a>
            }
            else
            {
                <a asp-action="Propiedades" asp-controller="Home" class="btn btn-secondary">Volver</a>
            }
        </div>
    }
</div>
