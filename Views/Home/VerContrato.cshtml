@model OSO.Models.RevisionContrato
@{
    var c = Model.Contrato;
}

<div class="revision-contrato">
    <h2>Contrato de alquiler</h2>
    <p class="revision-subtitulo">
        <strong>@Model.Propiedad.Direccion</strong> ·
        Estado: <span class="revision-estado">@c.EstadoParaInquilino</span>
        @if (!string.IsNullOrEmpty(c.ArchivoContrato))
        {
            <text> · </text><a asp-action="DescargarContrato" asp-controller="Home" asp-route-idContrato="@c.IdContrato" target="_blank">Ver el archivo del contrato</a>
        }
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (c.Estado == "Finalizado")
    {
        <div class="alert alert-warning">
            <strong>Este contrato terminó el @Formato.Fecha(c.FechaFinReal)</strong> · Motivo: @OSO.Models.ReglasContrato.NombreMotivoFin(c.MotivoFin).
            @if (!string.IsNullOrWhiteSpace(c.DescripcionFin))
            {
                <br /><span>Lo que explicó el propietario: @c.DescripcionFin</span>
            }
            <br /><span>Ya no estás vinculado a la propiedad. Seguís viendo el contrato y tus gastos hasta esa fecha.</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(c.DisconformidadInquilino))
        {
            <div class="card p-3 mb-3">
                <strong>Constancia de disconformidad</strong> (@c.FechaDisconformidad?.ToString("dd/MM/yyyy HH:mm"))
                <p>@c.DisconformidadInquilino</p>
            </div>
        }
        else if (c.MotivoFin != OSO.Models.ReglasContrato.FinDePlazo)
        {
            <form asp-action="DejarDisconformidad" asp-controller="Home" method="post" class="card p-3 mb-3"
                  onsubmit="return confirm('La constancia se guarda una sola vez y no se puede editar. ¿Enviarla?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idContrato" value="@c.IdContrato" />
                <label for="texto"><strong>Dejar constancia de disconformidad</strong></label>
                <p class="revision-ayuda">No cambia la terminación, pero queda registrada y la ven los dos. Se puede dejar una sola vez y no se edita.</p>
                <textarea name="texto" id="texto" class="form-control mb-2" rows="4" maxlength="1000" required></textarea>
                <button type="submit" class="btn btn-primary">Dejar constancia de disconformidad</button>
            </form>
        }
    }

    <div class="card p-3 mb-3">
        <div class="revision-lectura">
            <p><strong>Inicio:</strong> @Formato.Fecha(c.FechaInicio)</p>
            <p><strong>Fin:</strong> @Formato.Fecha(c.FechaFin)</p>
            <p><strong>Alquiler inicial:</strong> @Formato.Numero(c.MontoAlquiler) @c.Moneda</p>
            <p><strong>Vence el día:</strong> @Formato.Dato(c.DiaVencimiento)</p>
            <p><strong>Ajuste:</strong> @c.DescripcionAjuste</p>
            <p><strong>Medio de pago:</strong> @Formato.Dato(c.MedioPago)</p>
            <p><strong>Punitorio diario:</strong> @Formato.Dato(c.PunitorioDiario, "%")</p>
            <p><strong>Depósito:</strong> @c.DepositoTexto</p>
            <p><strong>Garantía:</strong> @Formato.Dato(c.TipoGarantia)</p>
            <p><strong>Preaviso para rescindir:</strong> @Formato.Dato(c.PreavisoRescisionDias, " días")</p>
            <p><strong>Régimen legal:</strong> @OSO.Models.ReglasContrato.NombreRegimen(c.RegimenLegal)</p>
        </div>
    </div>

    <h3>Quién paga cada gasto</h3>
    <div class="revision-tabla-wrap">
        <table class="revision-tabla">
            <thead>
                <tr><th>Gasto</th><th>Lo paga</th><th>Cláusula del contrato</th></tr>
            </thead>
            <tbody>
                @foreach (var regla in Model.Reglas)
                {
                    <tr>
                        <td>@regla.TipoGasto</td>
                        <td>@regla.QuienPagaParaInquilino</td>
                        <td class="revision-clausula">@(string.IsNullOrEmpty(regla.TextoClausula) ? "—" : regla.TextoClausula)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="contrato-actions">
        @if (c.Estado == "PendienteInquilino")
        {
            <form asp-action="AceptarContrato" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idContrato" value="@c.IdContrato" />
                <button type="submit" class="btn btn-primary">Aceptar contrato</button>
            </form>
        }
        @if (ViewBag.VolverANotificaciones == true)
        {
            <a asp-action="Notificaciones" asp-controller="Home" class="btn btn-primary">Volver a notificaciones</a>
        }
        else
        {
            <a asp-action="Propiedades" asp-controller="Home" class="btn btn-primary">Volver</a>
        }
    </div>
</div>
