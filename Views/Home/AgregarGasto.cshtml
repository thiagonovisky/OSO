@model OSO.Models.GastoPropiedad
@{
    var propiedad = ViewBag.Propiedad as OSO.Models.Propiedades;
    var tipoGasto = ViewBag.TipoGasto as OSO.Models.Gastos;
    var tipo = tipoGasto?.TipoGasto;
}

<h2>Agregar gasto para @tipo</h2>

@if (propiedad != null)
{
    <p>Propiedad: @propiedad.Direccion</p>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="GuardarGasto" asp-controller="Home" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idPropiedad" value="@propiedad?.IdPropiedad" />
    <input type="hidden" name="idGasto" value="@tipoGasto?.IdGasto" />

    <div>
        <label>Tipo de gasto</label>
        <input type="text" value="@tipo" disabled class="form-control" />
    </div>

    <div>
        <label>Mes</label>
        <input type="date" name="mes" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control" />
    </div>

    <div>
        <label>Monto</label>
        <input type="number" name="monto" step="0.01" min="0.01" required class="form-control" />
    </div>

    <div>
        <label>Fecha de vencimiento</label>
        <input type="date" name="fechaVencimiento" value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")" required class="form-control" />
    </div>

    @if (propiedad?.IdInquilino != null)
    {
        <div>
            <label>¿Quién paga?</label>
            <select name="responsable" class="form-control">
                <option value="">Según el contrato</option>
                <option value="Propietario">Propietario (todo)</option>
                <option value="Inquilino">Inquilino (todo)</option>
            </select>
        </div>
    }

    <div>
        <label>Estado</label>
        <select name="estado" class="form-control">
            <option value="A pagar">A pagar</option>
            <option value="Pagado">Pagado</option>
        </select>
    </div>

    <div>
        <label>Comprobante</label>
        <input type="file" name="comprobanteArchivo" accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar gasto</button>
    <a asp-action="ServicioDetalle" asp-controller="Home" asp-route-idPropiedad="@propiedad?.IdPropiedad" asp-route-tipo="@tipo" class="btn btn-primary">Cancelar</a>
</form>
