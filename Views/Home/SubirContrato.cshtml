@model OSO.Models.Propiedades
@{
    var inquilinos = ViewBag.Inquilinos as List<OSO.Models.Usuario> ?? new List<OSO.Models.Usuario>();
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Subir contrato</h2>
    <p class="pagina-bajada">Subí el contrato de <strong>@Model.Direccion</strong> (PDF o foto, hasta 10 MB). Lo leemos con inteligencia artificial y completamos los datos; después los revisás y confirmás vos.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <form asp-action="SubirContrato" asp-controller="Home" method="post" enctype="multipart/form-data" class="panel form-panel" id="formSubirContrato">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idPropiedad" value="@Model.IdPropiedad" />

        <div class="campo">
            <label for="idInquilino">Inquilino</label>
            <select name="idInquilino" id="idInquilino" required>
                <option value="">Elegí un inquilino</option>
                @foreach (var inquilino in inquilinos)
                {
                    <option value="@inquilino.IdInquilino" selected="@(Model.IdInquilino == inquilino.IdInquilino)">@inquilino.Nombre @inquilino.Apellido</option>
                }
            </select>
        </div>

        <div class="campo">
            <label for="archivo">Archivo del contrato</label>
            <input type="file" name="archivo" id="archivo" accept=".pdf,.jpg,.jpeg,.png,.webp" required />
        </div>

        <p class="aviso-pagina m-0" id="leyendo" role="status" hidden>Subiendo el contrato...</p>

        <div class="form-acciones">
            <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary" id="btnSubir">Subir y leer contrato</button>
        </div>
    </form>
</div>

<script>
    let enviado = false;
    document.getElementById('formSubirContrato').addEventListener('submit', function (e) {
        // Evita mandarlo dos veces (doble clic o Enter), que crearía el borrador y después daría error.
        if (enviado) {
            e.preventDefault();
            return;
        }
        enviado = true;
        document.getElementById('btnSubir').disabled = true;
        document.getElementById('leyendo').hidden = false;
    });
</script>
