@model List<OSO.Models.Expensas>

<h2>Expensas</h2>

@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

<form action='@Url.Action("AgregarExpensa", "Home")' method="get">
    <button type="submit">Agregar Expensa</button>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Propiedad</th>
                <th>Estado</th>
                <th>Fecha de vencimiento</th>
                <th>Monto</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expensa in Model)
            {
                <tr>
                    <td>@expensa.NombrePropiedad</td>
                    <td>@expensa.Estado</td>
                    <td>@expensa.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>$@expensa.Monto</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3">No hay expensas registradas.</p>
}