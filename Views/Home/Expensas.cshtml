@model List<OSO.Models.GastoPropiedad>

<h2>Expensas</h2>

@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

<form action='@Url.Action("AgregarExpensa", "Home")' method="get" class="text-center">
    <button type="submit">Agregar Expensa</button>
</form>

@if (Model != null && Model.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Propiedad</th>
                <th>Estado</th>
                <th>Fecha de vencimiento</th>
                <th>Monto</th>
                <th>Aclaración</th>
                <th>Fecha de pago</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expensa in Model)
            {
                <tr>
                    <td>@expensa.NombrePropiedad</td>
                    <td>@expensa.Estado</td>
                    <td>@expensa.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>$@expensa.Monto</td>
                    <td>@(string.IsNullOrWhiteSpace(expensa.Aclaracion) ? "-" : expensa.Aclaracion)</td>
                    <td>@(expensa.FechaPago.HasValue ? expensa.FechaPago.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        @if (!string.Equals(expensa.Estado, "Pagado", StringComparison.OrdinalIgnoreCase))
                        {
                            <form asp-action="PagarExpensa" asp-controller="Home" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idGastoResponsable" value="@expensa.IdGastoResponsable" />
                                <input type="file" name="comprobanteArchivo" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-success btn-sm">Confirmar pago</button>
                            </form>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3 text-center">No hay expensas registradas.</p>
}