@model List<OSO.Models.GastoPropiedad>

<h2>Expensas extraordinarias</h2>

<p class="text-center">Las expensas ordinarias llegan todos los meses: con el contrato confirmado aparecen solas en <a asp-action="MisGastos" asp-controller="Home">Mis gastos</a> de quien las paga.
Acá cargás las extraordinarias cuando el consorcio las decide; se reparten según el contrato y cada uno paga su parte con el comprobante.</p>

@if (TempData["Mensaje"] != null)
{
    <p>@TempData["Mensaje"]</p>
}

<form action='@Url.Action("AgregarExpensa", "Home")' method="get" class="text-center">
    <button type="submit">Agregar expensa extraordinaria</button>
</form>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Propiedad</th>
                <th>Estado</th>
                <th>Fecha de vencimiento</th>
                <th>Monto</th>
                <th>Tu parte</th>
                <th>Parte del inquilino</th>
                <th>Aclaración</th>
                <th>Fecha de pago</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expensa in Model)
            {
                <tr>
                    <td>@expensa.NombrePropiedad<br /><small>@expensa.TipoGasto</small></td>
                    <td>@expensa.Estado</td>
                    <td>@expensa.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                    <td>$@expensa.Monto</td>
                    <td>$@expensa.MontoResponsable</td>
                    <td>$@expensa.MontoInquilino</td>
                    <td>@(string.IsNullOrWhiteSpace(expensa.Aclaracion) ? "-" : expensa.Aclaracion)</td>
                    <td>@(expensa.FechaPago.HasValue ? expensa.FechaPago.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td>
                        @if (expensa.MontoPagado < expensa.MontoResponsable)
                        {
                            <form asp-action="PagarExpensa" asp-controller="Home" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idGastoResponsable" value="@expensa.IdGastoResponsable" />
                                <input type="file" name="comprobanteArchivo" accept=".jpg,.jpeg,.png,.webp,.pdf" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-success btn-sm">Confirmar pago</button>
                            </form>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="mt-3 text-center">No hay expensas extraordinarias registradas.</p>
}