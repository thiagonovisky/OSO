@model OSO.Models.Propiedades
@{
    var inquilinos = ViewBag.Inquilinos as List<OSO.Models.Usuario> ?? new List<OSO.Models.Usuario>();
}

<h2>Cargar contrato a mano</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>Elegí el inquilino. En el paso siguiente completás los datos del contrato y quién paga cada gasto.</p>

<form asp-action="GuardarContrato" asp-controller="Home" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idPropiedad" value="@Model.IdPropiedad" />

    <div class="form-group mb-3">
        <label for="idInquilino">Inquilino</label>
        <select name="idInquilino" id="idInquilino" class="form-control" required>
            <option value="">Seleccione un inquilino</option>
            @foreach (var inquilino in inquilinos)
            {
                <option value="@inquilino.IdInquilino" selected="@(Model.IdInquilino == inquilino.IdInquilino)">@inquilino.Nombre @inquilino.Apellido</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Continuar</button>
    <a asp-action="Contrato" asp-controller="Home" asp-route-idPropiedad="@Model.IdPropiedad" class="btn btn-primary">Cancelar</a>
</form>
