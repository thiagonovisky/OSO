@model OSO.Models.Propiedades

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Información de la propiedad</h2>
    <p class="pagina-bajada"><strong>@Model.Direccion</strong></p>

    <section class="panel">
        <img src="@Url.Content("~/imagenes/" + Model.Foto)" alt="@Model.Direccion" class="foto-propiedad--panel" />
        <dl class="datos">
            <div><dt>Superficie</dt><dd>@Model.Superficie m²</dd></div>
            <div><dt>Ambientes</dt><dd>@Model.Ambientes</dd></div>
            <div><dt>Estado</dt><dd>@Model.Estado</dd></div>
            <div><dt>Fecha de alta</dt><dd>@Model.FechaDeAlta.ToString("dd/MM/yyyy")</dd></div>
        </dl>
    </section>

    <div class="form-acciones form-acciones--centro">
        <a asp-action="Propiedades" asp-controller="Home" class="btn btn-secondary">Volver</a>
    </div>
</div>
