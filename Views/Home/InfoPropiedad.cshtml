@model OSO.Models.Propiedades

<h2>Información de la propiedad</h2>

<div>
	<img src="@Url.Content("~/imagenes/" + Model.Foto)" alt="@Model.Direccion" style="max-width: 420px; height: auto;" />
</div>

<p><strong>Dirección:</strong> @Model.Direccion</p>
<p><strong>Superficie: </strong>@Model.Superficie m²</p>
<p><strong>Ambientes:</strong> @Model.Ambientes</p>
<p><strong>Estado:</strong> @Model.Estado</p>
<p><strong>Fecha de alta:</strong> @Model.FechaDeAlta.ToString("dd/MM/yyyy")</p>

<a asp-action="Propiedades" asp-controller="Home">Volver</a>
