@{
    var menu = OSO.Models.MenuPrincipal.Para(Context.Session.GetString("EsPropietario") == "true");
}

<div class="bienvenida">
    <div class="bienvenida__header">
        <h1>Bienvenido</h1>
        <img src="~/imagenes/Logo colores.png" alt="OSO" />
    </div>

    <div class="bienvenida__grid">
        @foreach (var item in menu)
        {
            <a asp-controller="Home" asp-action="@item.Accion" class="bienvenida__card">
                <span class="bienvenida__icon"><partial name="_IconoMenu" model="item.Accion" /></span>
                <span class="bienvenida__label">@item.Texto</span>
            </a>
        }
    </div>
</div>
