@model OSO.Models.Usuario
@{
    ViewData["Title"] = "Perfil";
    var tieneFoto = !string.IsNullOrWhiteSpace(Model.FotoPerfil);
}

<div class="perfil-page">
    <div class="perfil-card">
        <div class="perfil-header-row">
            <div class="perfil-avatar-wrap">
                @if (tieneFoto)
                {
                    @* Si el archivo no existe o no carga, se oculta la imagen (sin mostrar el alt) y aparece la silueta. *@
                    <img src="@Url.Content("~/imagenes/" + Model.FotoPerfil)" alt="" class="perfil-avatar"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                }
                <svg class="perfil-avatar perfil-avatar--vacio" viewBox="0 0 64 64" role="img" aria-label="Sin foto de perfil"
                     style="@(tieneFoto ? "display:none" : "")">
                    <rect width="64" height="64" fill="#CFD8DC" />
                    <circle cx="32" cy="24" r="11" fill="#607D8B" />
                    <path d="M10 64c2-14 11-22 22-22s20 8 22 22z" fill="#607D8B" />
                </svg>
            </div>

            <div class="perfil-fields">
                <div class="perfil-field">
                    <label>Nombre</label>
                    <div class="perfil-value">@Model.Nombre @Model.Apellido</div>
                </div>

                <div class="perfil-field">
                    <label>Tipo de usuario</label>
                    <div class="perfil-value">@(Model.IdPropietario > 0 ? "Propietario" : "Inquilino")</div>
                </div>

                <div class="perfil-field">
                    <label>Usuario desde</label>
                    <div class="perfil-value">@Model.FechaAlta.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <form asp-controller="Home" asp-action="CerrarSesion" method="post" class="perfil-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="perfil-logout-btn">CERRAR SESIÓN</button>
            </form>
        </div>

        <div class="perfil-contact-card">
            <div class="perfil-section-title">
                <span class="perfil-section-icon">👤</span>
                <span>Información de contacto</span>
            </div>

            <div class="perfil-contact-grid">
                <div class="perfil-contact-item">
                    <label>Nombre</label>
                    <div>@Model.Nombre @Model.Apellido</div>
                </div>

                <div class="perfil-contact-item">
                    <label>Teléfono</label>
                    <div>@OSO.Models.TelefonoFormato.Formatear(Model.Telefono)</div>
                </div>

                <div class="perfil-contact-item">
                    <label>Email</label>
                    <div>@Model.Correo</div>
                </div>
            </div>
        </div>
    </div>
</div>
