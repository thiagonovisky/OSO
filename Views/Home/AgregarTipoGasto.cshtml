@model dynamic
@{
    var propiedad = ViewBag.Propiedad as OSO.Models.Propiedades;
    var sugeridos = ViewBag.TiposSugeridos as List<string> ?? new List<string>();
}

<h2>Agregar tipo de gasto</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


@if (propiedad != null)
{
    <p>Propiedad: @propiedad.Direccion</p>
}

<form asp-action="GuardarTipoGasto" asp-controller="Home" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idPropiedad" value="@propiedad?.IdPropiedad" />

    <div>
        <label>Nombre del tipo de gasto</label>
        <input type="text" name="nombreTipo" class="form-control" list="tiposSugeridos" autocomplete="off"
               placeholder="Ej: Internet, Mantenimiento, Seguro" maxlength="@OSO.Models.Gastos.LargoMaximoNombre" required />
        <datalist id="tiposSugeridos">
            @foreach (var tipo in sugeridos)
            {
                <option value="@tipo"></option>
            }
        </datalist>
        <small>Elegí uno de la lista para que tome lo que dice el contrato sobre quién lo paga; si no está, escribí el nombre.</small>
    </div>

    <button type="submit" class="btn btn-primary">Guardar tipo</button>
    <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@propiedad?.IdPropiedad" class="btn btn-primary">Cancelar</a>
</form>
