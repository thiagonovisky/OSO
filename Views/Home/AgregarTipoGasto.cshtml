@model dynamic
@{
    var propiedad = ViewBag.Propiedad as OSO.Models.Propiedades;
    var sugeridos = ViewBag.TiposSugeridos as List<string> ?? new List<string>();
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Agregar tipo de gasto</h2>
    @if (propiedad != null)
    {
        <p class="pagina-bajada"><strong>@propiedad.Direccion</strong></p>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <form asp-action="GuardarTipoGasto" asp-controller="Home" method="post" class="panel form-panel">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idPropiedad" value="@propiedad?.IdPropiedad" />

        <div class="campo">
            <label for="nombreTipo">Nombre del tipo de gasto</label>
            <input type="text" id="nombreTipo" name="nombreTipo" list="tiposSugeridos" autocomplete="off"
                   placeholder="Ej: Internet, Mantenimiento, Seguro" maxlength="@OSO.Models.Gastos.LargoMaximoNombre" required />
            <datalist id="tiposSugeridos">
                @foreach (var tipo in sugeridos)
                {
                    <option value="@tipo"></option>
                }
            </datalist>
            <small class="campo__ayuda">Elegí uno de la lista para que tome lo que dice el contrato sobre quién lo paga; si no está, escribí el nombre.</small>
        </div>

        <div class="form-acciones">
            <a asp-action="Servicios" asp-controller="Home" asp-route-idPropiedad="@propiedad?.IdPropiedad" class="btn btn-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar tipo</button>
        </div>
    </form>
</div>
