<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSO</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    string? accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    bool esPaginaPublica = accionActual == "Index" || accionActual == "Login" || accionActual == "Registro";
    bool esLanding = accionActual == "Index";

    // Menú principal (Models/MenuPrincipal): el mismo en el header, la bienvenida y el menú lateral.
    var menu = OSO.Models.MenuPrincipal.Para(Context.Session.GetString("EsPropietario") == "true");
    string? seccion = OSO.Models.MenuPrincipal.SeccionDe(accionActual);
}
<body>
    <a class="oso-saltar" href="#contenido">Saltar al contenido</a>
    <header class="oso-header">
        <div class="oso-header__inner">
            <a class="oso-brand" asp-area="" asp-controller="Home" asp-action="@(esPaginaPublica ? "Index" : "Bienvenida")" aria-label="OSO, ir al inicio">
                <span class="oso-brand__marca" aria-hidden="true"><img src="~/imagenes/Logo colores.png" alt="" /></span>
                <span class="oso-brand__nombre">OSO</span>
            </a>

            @if (esLanding)
            {
                <div class="oso-actions oso-actions--landing">
                    <a class="oso-nav__item oso-nav__item--landing" asp-area="" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                    <a class="oso-nav__item oso-nav__item--landing" asp-area="" asp-controller="Home" asp-action="Registro">Registrarse</a>
                </div>
            }

            @if (!esPaginaPublica)
            {
                <nav class="oso-nav" aria-label="Navegación principal">
                    @foreach (var item in menu)
                    {
                        bool activo = seccion == item.Accion;
                        <a class="oso-nav__item @(activo ? "active" : "")" aria-current="@(activo ? "page" : null)" title="@(item.TextoCorto != item.Texto ? item.Texto : null)"
                           asp-area="" asp-controller="Home" asp-action="@item.Accion">@item.TextoCorto</a>
                    }
                </nav>
            }

            @if (!esPaginaPublica)
            {
            <div class="oso-actions" aria-label="Acciones del usuario">
                <a class="oso-icon oso-icon--user" asp-area="" asp-controller="Home" asp-action="Perfil" aria-label="Perfil">
                    <partial name="_AvatarUsuario" />
                </a>

                <a class="oso-icon oso-icon--notification" asp-area="" asp-controller="Home" asp-action="Notificaciones" aria-label="Notificaciones">
                    <svg viewBox="0 0 64 64" aria-hidden="true">
                        <path d="M32 10v3" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                        <path d="M20 42V30a12 12 0 0 1 24 0v12l4 5H16z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
                        <path d="M27 52a5 5 0 0 0 10 0" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    </svg>
                    @if ((ViewBag.NotificacionesNoLeidas as int? ?? 0) > 0)
                    {
                        <span class="oso-badge">@ViewBag.NotificacionesNoLeidas</span>
                    }
                </a>

                <button class="oso-menu" type="button" aria-label="Menú" aria-controls="osoSidemenu" aria-expanded="false">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
            }
        </div>
    </header>
    @if (!esPaginaPublica)
    {
        var nombreMenu = Context.Session.GetString("NombreUsuario");
        bool esPropietario = Context.Session.GetString("EsPropietario") == "true";
        int notificacionesNoLeidas = ViewBag.NotificacionesNoLeidas as int? ?? 0;
        // Accesos de la cuenta, debajo del menú principal.
        var deLaCuenta = new[] { ("Bienvenida", "Inicio"), ("Perfil", "Perfil"), ("Notificaciones", "Notificaciones") };

        <span class="oso-sidemenu-backdrop" id="osoSidemenuBackdrop" hidden></span>
        <aside class="oso-sidemenu" id="osoSidemenu" aria-label="Menú" aria-hidden="true">
            <div class="oso-sidemenu__cabecera">
                <span class="oso-sidemenu__avatar"><partial name="_AvatarUsuario" /></span>
                <div class="oso-sidemenu__saludo">
                    <p class="oso-sidemenu__nombre">Hola, @(string.IsNullOrWhiteSpace(nombreMenu) ? "Usuario" : nombreMenu)</p>
                    <p class="oso-sidemenu__rol">@(esPropietario ? "Propietario" : "Inquilino")</p>
                </div>
                <button type="button" class="oso-sidemenu__cerrar" aria-label="Cerrar menú">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </button>
            </div>

            <nav class="oso-sidemenu__nav" aria-label="Menú">
                @foreach (var item in menu)
                {
                    bool activo = seccion == item.Accion;
                    <a class="oso-sidemenu__item @(activo ? "active" : "")" aria-current="@(activo ? "page" : null)" asp-controller="Home" asp-action="@item.Accion">
                        <span class="oso-sidemenu__icono"><partial name="_IconoMenu" model="item.Accion" /></span>
                        <span>@item.Texto</span>
                    </a>
                }

                <hr class="oso-sidemenu__separador" />

                @foreach (var (accion, texto) in deLaCuenta)
                {
                    bool activo = accionActual == accion;
                    <a class="oso-sidemenu__item @(activo ? "active" : "")" aria-current="@(activo ? "page" : null)" asp-controller="Home" asp-action="@accion">
                        <span class="oso-sidemenu__icono"><partial name="_IconoMenu" model="accion" /></span>
                        <span>@texto</span>
                        @if (accion == "Notificaciones" && notificacionesNoLeidas > 0)
                        {
                            <span class="oso-sidemenu__contador" aria-label="@notificacionesNoLeidas sin leer">@notificacionesNoLeidas</span>
                        }
                    </a>
                }
            </nav>

            <form asp-controller="Home" asp-action="CerrarSesion" method="post" class="oso-sidemenu__logout">
                <button type="submit" class="oso-sidemenu__salir">
                    <span class="oso-sidemenu__icono"><partial name="_IconoMenu" model="@("CerrarSesion")" /></span>
                    Cerrar sesión
                </button>
            </form>
        </aside>
    }
    <main id="contenido" class="@(esLanding ? "main main--landing" : "main")">
        @RenderBody()
    </main>

    <footer class="oso-footer">
        <div class="oso-footer__inner">
            <div class="oso-footer__marca">
                <a class="oso-brand" asp-area="" asp-controller="Home" asp-action="@(esPaginaPublica ? "Index" : "Bienvenida")" aria-label="OSO, ir al inicio">
                    <span class="oso-brand__marca" aria-hidden="true"><img src="~/imagenes/Logo colores.png" alt="" /></span>
                    <span class="oso-brand__nombre">OSO</span>
                </a>
                <p>Contratos, gastos y pagos de tus alquileres en un solo lugar, para propietarios e inquilinos.</p>
            </div>

            <nav class="oso-footer__nav" aria-label="Enlaces del pie de página">
                @if (esPaginaPublica)
                {
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    <a asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                    <a asp-controller="Home" asp-action="Registro">Registrarse</a>
                }
                else
                {
                    @foreach (var item in menu)
                    {
                        <a asp-controller="Home" asp-action="@item.Accion">@item.Texto</a>
                    }
                    <a asp-controller="Home" asp-action="Perfil">Perfil</a>
                    <a asp-controller="Home" asp-action="Notificaciones">Notificaciones</a>
                }
            </nav>
        </div>
        <p class="oso-footer__legal">&copy; @DateTime.Now.Year OSO. Todos los derechos reservados.</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
