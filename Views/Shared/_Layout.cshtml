<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OSO</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OSO.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="oso-header">
        <div class="oso-header__inner">
            <a class="oso-brand" asp-area="" asp-controller="Home" asp-action="Bienvenida" aria-label="Inicio">O.S.O</a>

            @if (!(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ||
                   ViewContext.RouteData.Values["action"]?.ToString() == "Login" ||
                   ViewContext.RouteData.Values["action"]?.ToString() == "Registro"))
            {
                <nav class="oso-nav" aria-label="Navegación principal">
                    <a class="oso-nav__item" asp-area="" asp-controller="Home" asp-action="Calendario">Calendario</a>
                    <a class="oso-nav__item active" asp-area="" asp-controller="Home" asp-action="Propiedades">Propiedades</a>
                    <a class="oso-nav__item" asp-area="" asp-controller="Home" asp-action="Mensajeria">Mensajería</a>
                </nav>
            }

            <div class="oso-actions" aria-label="Acciones del usuario">
                <a class="oso-icon oso-icon--user" asp-area="" asp-controller="Home" asp-action="Perfil" aria-label="Perfil">
                    @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("FotoPerfil")))
                    {
                        <img src="@Url.Content("~/imagenes/" + Context.Session.GetString("FotoPerfil"))" alt="Foto de perfil" class="oso-header-avatar" />
                    }
                    else
                    {
                        <svg viewBox="0 0 64 64" aria-hidden="true">
                            <circle cx="32" cy="22" r="12" fill="none" stroke="currentColor" stroke-width="4" />
                            <path d="M15 52c3.5-8.5 11.2-13 17-13s13.5 4.5 17 13" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                        </svg>
                    }
                </a>

                <a class="oso-icon oso-icon--notification" href="#" aria-label="Notificaciones">
                    <svg viewBox="0 0 64 64" aria-hidden="true">
                        <path d="M22 48h20l-3-18c-1-11-6-16-14-16s-13 5-14 16l-3 18h14z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/>
                        <path d="M28 54c1.5 3 3 4 4 4s2.5-1 4-4" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
                    </svg>
                </a>

                <button class="oso-menu" type="button" aria-label="Menú">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
