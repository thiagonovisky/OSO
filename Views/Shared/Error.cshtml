@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="pagina pagina--angosta">
    <h2 class="pagina-titulo">Algo salió mal</h2>
    <p class="pagina-bajada">No pudimos completar lo que pediste. Probá de nuevo en un momento; si sigue pasando, avisanos.</p>

    <div class="form-acciones form-acciones--centro">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ir al inicio</a>
    </div>

    @if (Model?.ShowRequestId == true)
    {
        <p class="campo__ayuda text-center mt-4">Código del error: <code>@Model.RequestId</code></p>
    }
</div>
